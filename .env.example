# NetConfArena — local configuration. Copy to .env and edit.
#   cp .env.example .env
# .env is git-ignored and is loaded automatically by main.py,
# scripts/pipeline/stage2/validate_task.py, and the MCP server.

# --- Emulator -----------------------------------------------------------------
# Address of the GNS3 server (v2.2.x) and its projects directory.
GNS3_SERVER=127.0.0.1
GNS3_PROJECT_PATH=/home/<user>/GNS3/projects

# --- Model endpoint -----------------------------------------------------------
# Any OpenAI-compatible endpoint. Set LLM_BASE_URL to point at a self-hosted
# server (vLLM, SGLang, Ollama, ...); leave it unset to use the OpenAI API,
# in which case OPENAI_API_KEY is read from the environment as usual.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_API_KEY=EMPTY

# OPENAI_API_KEY=<your-key>

# Optional website collector only. Prefer a local checkout of the
# public GNS3Vault archive; never commit a session cookie.
# GNS3VAULT_COOKIE=

# --- MCP server (optional) ----------------------------------------------------
# A harness selects one task before starting the server. These are not agent
# actions and are therefore configured out of band.
# NETCONFARENA_TASK_INDEX=1
# NETCONFARENA_TASK_SEED=1
# NETCONFARENA_TRIAL=1
# NETCONFARENA_RESULT_PATH=results/mcp-run.json
# NETCONFARENA_MCP_MODEL=mcp-client

# Transport for mcp_server/server.py: stdio | sse | streamable-http
# NETCONFARENA_MCP_TRANSPORT=stdio
