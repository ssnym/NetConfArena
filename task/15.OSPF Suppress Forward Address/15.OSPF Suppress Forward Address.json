    "scenario": "OSPF Suppress Forward Address",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows, and ensure Area 1 is a NSSA.\n    Area 0:\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router5_name}}'s {{router5_link2_iface}}\n    Area 1:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router3_name}}'s {{router3_link1_iface}}\n    Area 2:\n        {{router5_name}}'s {{router5_link3_iface}}\n        {{router2_name}}'s {{router2_link3_iface}}\n• Configure RIP between router {{router3_name}} and {{router4_name}}.\n• Create a Loopback0 interface on router {{router4_name}} with IP address {{router4_loopback_ip}} /24 and advertise it in RIP.\n• Redistribute between RIP and OSPF.\n• Configure a prefix-list on router {{router5_name}} which filters network {{link1_network}} /{{link1_prefix_len}}.\n• Ensure you can still reach network {{router4_loopback_network}} /24 from all OSPF routers without removing the prefix-list. You are only allowed to use OSPF commands.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface {{router3_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback_ip}} {{router4_loopback_mask}}",
            "interface {{router4_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router5_name}}": [
            "interface {{router5_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router5_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 nssa translate type7 suppress-fa",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 1"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{link3_network}} {{link3_wildcard}} area 2"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 nssa",
            "  redistribute rip subnets",
            "  network {{link1_network}} {{link1_wildcard}} area 1",
            "router rip",
            "  version 2",
            "  redistribute ospf 1 metric 1",
            "  network {{link4_network}}"
        ],
        "{{router4_name}}": [
            "router rip",
            "  version 2",
            "  network 1.0.0.0",
            "  network {{link4_network}}"
        ],
        "{{router5_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "  network {{link3_network}} {{link3_wildcard}} area 2",
            "  distribute-list prefix BLOCK_LINK1 in",
            "ip prefix-list BLOCK_LINK1 seq 5 deny {{link1_network}}/{{link1_prefix_len}}",
            "ip prefix-list BLOCK_LINK1 seq 10 permit 0.0.0.0/0 le 32"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows, and ensure Area 1 is a NSSA.\n    Area 0:\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router5_name}}'s {{router5_link2_iface}}\n    Area 1:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router3_name}}'s {{router3_link1_iface}}\n    Area 2:\n        {{router5_name}}'s {{router5_link3_iface}}\n        {{router2_name}}'s {{router2_link3_iface}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router1_link2_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router1_link1_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "interface": "{{router3_link1_iface}}",
                        "area": "1"
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router5_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router5_link2_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router5_link3_iface}}",
                                "area": "2"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "interface": "{{router2_link3_iface}}",
                        "area": "2"
                    }
                }
            ]
        },
        {
            "goal": "Configure RIP between router {{router3_name}} and {{router4_name}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{link4_network}}/{{link4_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router4_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{router4_loopback_network}}/24",
                            "{{link4_network}}/{{link4_prefix_len}}"
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Create a Loopback0 interface on router {{router4_name}} with IP address {{router4_loopback_ip}} /24 and advertise it in RIP.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router4_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{router4_loopback_network}}/24"
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Redistribute between RIP and OSPF.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "redistribute": {
                            "op": "contains_all",
                            "value": [
                                "ospf"
                            ]
                        }
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {
                        "redistribute": {
                            "op": "contains_all",
                            "value": [
                                "rip, includes subnets in redistribution"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Configure a prefix-list on router {{router5_name}} which filters network {{link1_network}} /{{link1_prefix_len}}.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router5_name}}",
                    "command": "show ip prefix-list",
                    "expected_result": {
                        "action": "deny",
                        "network": "{{link1_network}}",
                        "netmask": "{{link1_prefix_len}}"
                    },
                    "output": "name"
                },
                {
                    "id": "5-2",
                    "node": "{{router5_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {
                        "incoming_update_filter": {
                            "op": "contains_all",
                            "value": [
                                "Incoming update filter list for all interfaces is (prefix-list) $5-1_{{router5_name}}_name$"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Ensure you can still reach network {{router4_loopback_network}} /24 from all OSPF routers without removing the prefix-list. You are only allowed to use OSPF commands.",
            "testcase": [
                {
                    "id": "6-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf database external",
                    "expected_result": {
                        "op": "all_match",
                        "value": {
                            "forward_address": "0.0.0.0"
                        }
                    }
                },
                {
                    "id": "6-2",
                    "node": "{{router5_name}}",
                    "command": "ping {{router4_loopback_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                },
                {
                    "id": "6-3",
                    "node": "{{router2_name}}",
                    "command": "ping {{router4_loopback_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                }
            ]
        }
    ],
