    "groundtruth_configs": {
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  xconnect {{router4_loopback0_ip}} {{vc_id}} encapsulation mpls"
        ],
        "{{router4_name}}": [
            "interface {{router4_link4_iface}}",
            "  xconnect {{router2_loopback0_ip}} {{vc_id}} encapsulation mpls"
        ]
    },
    "testcases": [
        {
            "goal": "Bind the whole customer-facing interface of each PE to a pseudowire towards the remote PE Loopback0, using MPLS encapsulation and virtual circuit identifier {{vc_id}} on both ends.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include xconnect",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "xconnect {{router4_loopback0_ip}} {{vc_id}} encapsulation mpls"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include xconnect",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "xconnect {{router2_loopback0_ip}} {{vc_id}} encapsulation mpls"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "The virtual circuit must come up on both PEs.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show mpls l2transport vc",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router2_link1_iface}}",
                                "dest_address": "{{router4_loopback0_ip}}",
                                "vc_id": "{{vc_id}}",
                                "status": {
                                    "op": "regex",
                                    "value": "UP"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router4_name}}",
                    "command": "show mpls l2transport vc",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router4_link4_iface}}",
                                "dest_address": "{{router2_loopback0_ip}}",
                                "vc_id": "{{vc_id}}",
                                "status": {
                                    "op": "regex",
                                    "value": "UP"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "2-3",
                    "node": "{{router2_name}}",
                    "command": "show xconnect all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "xc_state": "UP",
                                "s1_state": "UP",
                                "s2_state": "UP"
                            }
                        ]
                    }
                },
                {
                    "id": "2-4",
                    "node": "{{router2_name}}",
                    "command": "show mpls l2transport vc",
                    "expected_result": {
                        "op": "all_match",
                        "value": {
                            "local_circuit": {
                                "op": "contains",
                                "value": "Ethernet"
                            }
                        }
                    }
                }
            ]
        },
        {
            "goal": "Do not give the customer-facing PE interfaces an IP address and do not route the customer subnet: {{router1_name}} and {{router5_name}} must reach each other as direct layer 2 neighbours.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show ip route {{service_network}} {{service_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router4_name}}",
                    "command": "show ip route {{service_network}} {{service_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router1_name}}",
                    "command": "ping {{service_ip2}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "3-4",
                    "node": "{{router5_name}}",
                    "command": "ping {{service_ip1}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
