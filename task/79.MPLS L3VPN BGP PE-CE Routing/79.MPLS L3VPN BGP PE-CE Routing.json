  "startup_configs": {
    "{{router3_name}}": [
      "interface Loopback0",
      "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
      "interface {{router3_link2_iface}}",
      "  ip address {{link2_ip2}} {{link2_mask}}",
      "  no shutdown",
      "interface {{router3_link3_iface}}",
      "  ip address {{link3_ip1}} {{link3_mask}}",
      "  no shutdown",
      "router ospf 1",
      "  router-id {{router3_loopback0_ip}}",
      "  network {{router3_loopback0_ip}} 0.0.0.0 area 0",
      "  network {{link2_network}} {{link2_wildcard}} area 0",
      "  network {{link3_network}} {{link3_wildcard}} area 0",
      "mpls label protocol ldp",
      "mpls ldp router-id Loopback0 force",
      "interface {{router3_link2_iface}}",
      "  mpls ip",
      "interface {{router3_link3_iface}}",
      "  mpls ip"
    ],
    "{{router2_name}}": [
      "interface Loopback0",
      "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
      "interface {{router2_link2_iface}}",
      "  ip address {{link2_ip1}} {{link2_mask}}",
      "  no shutdown",
      "router ospf 1",
      "  router-id {{router2_loopback0_ip}}",
      "  network {{router2_loopback0_ip}} 0.0.0.0 area 0",
      "  network {{link2_network}} {{link2_wildcard}} area 0",
      "mpls label protocol ldp",
      "mpls ldp router-id Loopback0 force",
      "interface {{router2_link2_iface}}",
      "  mpls ip",
      "ip vrf {{vrf_name}}",
      "  rd {{rd}}",
      "  route-target export {{rt}}",
      "  route-target import {{rt}}",
      "interface {{router2_link1_iface}}",
      "  ip vrf forwarding {{vrf_name}}",
      "  ip address {{link1_ip2}} {{link1_mask}}",
      "  no shutdown",
      "router bgp {{as_number}}",
      "  no synchronization",
      "  bgp log-neighbor-changes",
      "  neighbor {{router4_loopback0_ip}} remote-as {{as_number}}",
      "  neighbor {{router4_loopback0_ip}} update-source Loopback0",
      "  no auto-summary",
      "  address-family vpnv4",
      "    neighbor {{router4_loopback0_ip}} activate",
      "    neighbor {{router4_loopback0_ip}} send-community extended",
