      "  route-target import {{rt}}",
      "interface {{router4_link4_iface}}",
      "  ip vrf forwarding {{vrf_name}}",
      "  ip address {{link4_ip1}} {{link4_mask}}",
      "  no shutdown",
      "router bgp {{as_number}}",
      "  no synchronization",
      "  bgp log-neighbor-changes",
      "  neighbor {{router2_loopback0_ip}} remote-as {{as_number}}",
      "  neighbor {{router2_loopback0_ip}} update-source Loopback0",
      "  no auto-summary",
      "  address-family vpnv4",
      "    neighbor {{router2_loopback0_ip}} activate",
      "    neighbor {{router2_loopback0_ip}} send-community extended",
      "  exit-address-family"
    ],
    "{{router1_name}}": [
      "interface Loopback1",
      "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
      "interface {{router1_link1_iface}}",
      "  ip address {{link1_ip1}} {{link1_mask}}",
      "  no shutdown",
      "router bgp {{ce1_as}}",
      "  no synchronization",
      "  bgp log-neighbor-changes",
      "  network {{router1_loopback1_network}} mask {{router1_loopback1_mask}}",
      "  neighbor {{link1_ip2}} remote-as {{as_number}}",
      "  no auto-summary"
    ],
    "{{router5_name}}": [
      "interface Loopback1",
      "  ip address {{router5_loopback1_ip}} {{router5_loopback1_mask}}",
      "interface {{router5_link4_iface}}",
      "  ip address {{link4_ip2}} {{link4_mask}}",
      "  no shutdown",
      "router bgp {{ce2_as}}",
      "  no synchronization",
      "  bgp log-neighbor-changes",
      "  network {{router5_loopback1_network}} mask {{router5_loopback1_mask}}",
      "  neighbor {{link4_ip1}} remote-as {{as_number}}",
      "  no auto-summary"
    ]
  },
  "groundtruth_configs": {
    "{{router2_name}}": [
      "router bgp {{as_number}}",
      "  address-family ipv4 vrf {{vrf_name}}",
      "    neighbor {{link1_ip1}} remote-as {{ce1_as}}",
      "    neighbor {{link1_ip1}} activate",
      "    no synchronization",
      "  exit-address-family"
    ],
    "{{router4_name}}": [
      "router bgp {{as_number}}",
      "  address-family ipv4 vrf {{vrf_name}}",
      "    neighbor {{link4_ip2}} remote-as {{ce2_as}}",
      "    neighbor {{link4_ip2}} activate",
      "    no synchronization",
      "  exit-address-family"
    ]
  },
  "testcases": [
    {
      "goal": "Inside the {{vrf_name}} IPv4 address family of AS {{as_number}}, peer with the local customer router over the VRF interface and activate that neighbor.",
      "testcase": [
        {
          "id": "1-1",
          "node": "{{router2_name}}",
          "command": "show ip bgp vpnv4 vrf {{vrf_name}} neighbors {{link1_ip1}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "neighbor": "{{link1_ip1}}",
                "bgp_state": "Established",
                "remote_as": "{{ce1_as}}"
              }
            ]
          }
        },
        {
          "id": "1-2",
          "node": "{{router4_name}}",
          "command": "show ip bgp vpnv4 vrf {{vrf_name}} neighbors {{link4_ip2}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "neighbor": "{{link4_ip2}}",
                "bgp_state": "Established",
                "remote_as": "{{ce2_as}}"
              }
            ]
          }
        },
        {
          "id": "1-3",
          "node": "{{router2_name}}",
          "command": "show running-config | include address-family ipv4 vrf",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "address-family ipv4 vrf {{vrf_name}}"
              }
            ]
          }
        }
      ]
    },
    {
      "goal": "No redistribution of static or connected routes is allowed: the customer prefixes must enter the VPN through the PE-CE BGP session only.",
      "testcase": [
        {
          "id": "2-1",
          "node": "{{router2_name}}",
          "command": "show running-config | include redistribute",
          "expected_result": {
            "op": "empty"
          }
        },
        {
          "id": "2-2",
          "node": "{{router4_name}}",
          "command": "show running-config | include redistribute",
          "expected_result": {
            "op": "empty"
          }
        }
      ]
    },
    {
      "goal": "Both PEs must hold both customer prefixes in their VPNv4 table.",
      "testcase": [
        {
          "id": "3-1",
          "node": "{{router2_name}}",
          "command": "show ip bgp vpnv4 all",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "rd": "{{rd}}",
                "prefix": "{{router1_loopback1_cidr}}"
              },
              {
                "rd": "{{rd}}",
                "prefix": "{{router5_loopback1_cidr}}",
                "next_hop": "{{router4_loopback0_ip}}"
              }
            ]
          }
        },
        {
          "id": "3-2",
          "node": "{{router4_name}}",
          "command": "show ip bgp vpnv4 all",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "rd": "{{rd}}",
                "prefix": "{{router5_loopback1_cidr}}"
              },
              {
                "rd": "{{rd}}",
                "prefix": "{{router1_loopback1_cidr}}",
                "next_hop": "{{router2_loopback0_ip}}"
              }
            ]
          }
        }
      ]
    },
    {
      "goal": "Each customer router must learn the remote site prefix through BGP, and {{router1_name}} must reach {{router5_loopback1_cidr}}.",
      "testcase": [
        {
          "id": "4-1",
          "node": "{{router1_name}}",
          "command": "show ip route {{router5_loopback1_network}} {{router5_loopback1_mask}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "network": "{{router5_loopback1_cidr}}",
                "protocol": "bgp",
                "nexthop_ip": "{{link1_ip2}}"
              }
            ]
          }
        },
        {
          "id": "4-2",
          "node": "{{router5_name}}",
          "command": "show ip route {{router1_loopback1_network}} {{router1_loopback1_mask}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "network": "{{router1_loopback1_cidr}}",
                "protocol": "bgp"
              }
            ]
          }
        },
        {
          "id": "4-3",
          "node": "{{router1_name}}",
          "command": "ping {{router5_loopback1_ip}} source Loopback1",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        },
        {
          "id": "4-4",
          "node": "{{router5_name}}",
          "command": "ping {{router1_loopback1_ip}} source Loopback1",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
