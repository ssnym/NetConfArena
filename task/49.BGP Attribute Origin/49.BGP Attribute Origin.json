{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "as1": {
            "type": "choice",
            "options": "as1_options"
        },
        "as2": {
            "type": "choice",
            "options": "as2_options",
            "different_from": [
                "as1"
            ]
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.23.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.12.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_cidr": {
            "type": "format",
            "template": "{link2_network}/{link2_prefix_len}"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "_origin_prefix": {
            "type": "random_subnet",
            "pool": "origin_prefix_pool",
            "prefix_len": "origin_prefix_lens",
            "default": "13.13.13.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "origin_prefix_network": {
            "type": "subnet_attr",
            "subnet": "_origin_prefix",
            "attr": "network"
        },
        "origin_prefix_mask": {
            "type": "subnet_attr",
            "subnet": "_origin_prefix",
            "attr": "netmask"
        },
        "origin_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_origin_prefix",
            "attr": "prefixlen"
        },
        "origin_prefix_wildcard": {
            "type": "subnet_attr",
            "subnet": "_origin_prefix",
            "attr": "wildcard"
        },
        "origin_prefix_cidr": {
            "type": "format",
            "template": "{origin_prefix_network}/{origin_prefix_len}"
        },
        "router1_origin_ip": {
            "type": "subnet_attr",
            "subnet": "_origin_prefix",
            "attr": "host",
            "index": 1
        },
        "router3_origin_ip": {
            "type": "subnet_attr",
            "subnet": "_origin_prefix",
            "attr": "host",
            "index": 2
        }
    },
    "scenario": "BGP Attribute Origin",
    "goals": "• Configure EBGP between router {{router3_name}} and {{router2_name}}.\n• Configure EBGP between router {{router1_name}} and {{router2_name}}.\n  AS {{as1}}: {{router1_name}}, {{router3_name}}\n  AS {{as2}}: {{router2_name}}\n• Routers {{router1_name}} and {{router3_name}} are both connected to network {{origin_prefix_network}} /{{origin_prefix_len}} on Loopback0 for this task. Advertise that network in BGP on both routers.\n• Make sure router {{router2_name}} sends traffic to {{origin_prefix_network}} /{{origin_prefix_len}} to router {{router1_name}}. You are only allowed to use the origin attribute.",
    "topology_model": {
        "nodes": [
            "r1",
            "r2",
            "r3"
        ],
        "links": [
            {
                "id": "link1",
                "nodes": [
                    "r1",
                    "r2"
                ],
                "media": "{{link1_media}}"
            },
            {
                "id": "link2",
                "nodes": [
                    "r2",
                    "r3"
                ],
                "media": "{{link2_media}}"
            }
        ]
    },
    "topology_attributes": {
        "nodes": {
            "r1": {
                "type": "C3600",
                "label": {
                    "text": "{{router1_name}}",
                    "x": 19.5,
