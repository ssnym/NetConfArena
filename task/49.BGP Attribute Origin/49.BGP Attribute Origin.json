                "x": -560.0285707,
                "y": -181.019335984,
                "z": -2.0
            }
        ]
    },
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_origin_ip}} {{origin_prefix_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_origin_ip}} {{origin_prefix_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{origin_prefix_network}} mask {{origin_prefix_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link2_ip2}} remote-as {{as1}}",
            "  neighbor {{link2_ip2}} route-map TEST in",
            "  neighbor {{link1_ip1}} remote-as {{as1}}",
            "  no auto-summary",
            "access-list 1 permit {{origin_prefix_network}} {{origin_prefix_wildcard}}",
            "route-map TEST permit 10",
            "  match ip address 1",
            "  set origin incomplete",
            "route-map TEST permit 20"
        ],
        "{{router3_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{origin_prefix_network}} mask {{origin_prefix_mask}}",
            "  neighbor {{link2_ip1}} remote-as {{as2}}",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between router {{router3_name}} and {{router2_name}}.",
            "testcase": [
                {
                    "id": "1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip2}}",
                        "remote_ip": "{{link2_ip1}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between router {{router1_name}} and {{router2_name}}.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip1}}",
                        "remote_ip": "{{link1_ip2}}"
                    }
                }
            ]
        },
        {
            "goal": "Routers {{router1_name}} and {{router3_name}} are both connected to network {{origin_prefix_network}} /{{origin_prefix_len}} on Loopback0 for this task. Advertise that network in BGP on both routers.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{origin_prefix_cidr}}"
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{origin_prefix_cidr}}"
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{origin_prefix_cidr}}",
                                "next_hop": "{{link1_ip1}}"
                            },
                            {
                                "network": "{{origin_prefix_cidr}}",
                                "next_hop": "{{link2_ip2}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Make sure router {{router2_name}} sends traffic to {{origin_prefix_network}} /{{origin_prefix_len}} to router {{router1_name}}. You are only allowed to use the origin attribute.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{origin_prefix_cidr}}",
                                "next_hop": "{{link1_ip1}}",
                                "origin": "i"
                            },
                            {
                                "network": "{{origin_prefix_cidr}}",
                                "next_hop": "{{link2_ip2}}",
                                "origin": "?"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router2_name}}",
                    "command": "show ip route",
                    "expected_result": {
                        "network": "{{origin_prefix_network}}",
                        "prefix_length": "{{origin_prefix_len}}",
                        "nexthop_ip": "{{link1_ip1}}"
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{origin_prefix_cidr}}",
                                "next_hop": "{{link1_ip1}}",
                                "origin": "i"
                            },
                            {
                                "network": "{{origin_prefix_cidr}}",
                                "next_hop": "{{link2_ip2}}",
                                "origin": "?"
                            }
                        ]
                    }
                },
                {
                    "id": "4-4",
                    "node": "{{router2_name}}",
                    "command": "show ip route",
                    "expected_result": {
                        "network": "{{origin_prefix_network}}",
                        "prefix_length": "{{origin_prefix_len}}",
                        "nexthop_ip": "{{link1_ip1}}"
                    }
                },
                {
                    "id": "4-5",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include local-preference|weight|as-path|metric|med",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-6",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include local-preference|weight|as-path|metric|med",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-7",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include local-preference|weight|as-path|metric|med",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
