                },
                "x": -475.0,
                "y": 29.0
            },
            "r2": {
                "type": "C3600",
                "label": {
                    "text": "{{router2_name}}",
                    "x": 19.5,
                    "y": -25.0
                },
                "x": -259.0,
                "y": -75.0
            },
            "r3": {
                "type": "C3600",
                "label": {
                    "text": "{{router3_name}}",
                    "x": 19.5,
                    "y": -25.0
                },
                "x": -475.0,
                "y": -151.0
            }
        },
        "notes": [
            {
                "color": "#0000ff",
