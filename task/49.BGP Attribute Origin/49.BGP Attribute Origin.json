            {
                "color": "#1a1a1a",
                "text": "AS {{as1}}",
                "x": -555.785930013,
                "y": -180.998520704
            }
        ],
        "rectangles": [
            {
                "fill_color": "#ffc94a",
                "height": 270.840403796,
