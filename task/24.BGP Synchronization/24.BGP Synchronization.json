{
    "params": {
        "as1": {
            "type": "fixed",
            "default": "1"
        },
        "as2": {
            "type": "fixed",
            "default": "2"
        },
        "as3": {
            "type": "fixed",
            "default": "3"
        },
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name"
            ]
        },
        "router5_name": {
            "type": "choice",
            "options": "r5_names",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name",
                "router4_name"
            ]
        },
        "_r1_lo0": {
            "type": "random_subnet",
            "pool": "r1_lo0_pool",
            "prefix_len": 24,
            "default": "1.1.1.0/24"
        },
        "router1_lo0_ip": {
            "type": "subnet_attr",
            "subnet": "_r1_lo0",
            "attr": "host",
            "index": 1
        },
        "router1_lo0_network": {
            "type": "subnet_attr",
            "subnet": "_r1_lo0",
            "attr": "network"
        },
        "router1_lo0_mask": {
            "type": "subnet_attr",
