    "scenario": "BGP Synchronization",
    "goals": "• Configure OSPF within AS {{as2}} ({{router2_name}}, {{router4_name}}, {{router3_name}}) to advertise the Loopback0 interfaces. {{router4_name}} is an AS {{as2}} internal router that runs only OSPF, not BGP. Do not advertise or run OSPF on the links interconnecting AS {{as1}} ({{router1_name}}) and AS {{as3}} ({{router5_name}}).\n• Configure IBGP between {{router2_name}} and {{router3_name}} (both in AS {{as2}}). Source the BGP updates from their Loopback0 interfaces.\n• Enable BGP synchronization on {{router2_name}} and {{router3_name}}.\n• Configure EBGP between {{router2_name}} (AS {{as2}}) and {{router1_name}} (AS {{as1}}).\n• Configure EBGP between {{router3_name}} (AS {{as2}}) and {{router5_name}} (AS {{as3}}).\n• Advertise the Loopback0 interfaces on {{router1_name}} (AS {{as1}}) and {{router5_name}} (AS {{as3}}) into BGP.\n• Ensure AS {{as1}} and AS {{as3}} can communicate with each other without removing the BGP synchronization command.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_lo0_ip}} {{router1_lo0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_lo0_ip}} {{router2_lo0_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_lo0_ip}} {{router3_lo0_mask}}",
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_lo0_ip}} {{router4_lo0_mask}}",
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router5_name}}": [
            "interface Loopback0",
            "  ip address {{router5_lo0_ip}} {{router5_lo0_mask}}",
            "interface {{router5_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_lo0_network}} mask {{router1_lo0_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  redistribute bgp {{as2}} subnets",
            "  network {{router2_lo0_network}} {{router2_lo0_wildcard}} area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "router bgp {{as2}}",
            "  synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router3_lo0_ip}} remote-as {{as2}}",
            "  neighbor {{router3_lo0_ip}} update-source Loopback0",
            "  neighbor {{router3_lo0_ip}} next-hop-self",
            "  neighbor {{link1_ip1}} remote-as {{as1}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  redistribute bgp {{as2}} subnets",
            "  network {{router3_lo0_network}} {{router3_lo0_wildcard}} area 0",
            "  network {{link3_network}} {{link3_wildcard}} area 0",
            "router bgp {{as2}}",
            "  synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router2_lo0_ip}} remote-as {{as2}}",
            "  neighbor {{router2_lo0_ip}} update-source Loopback0",
            "  neighbor {{router2_lo0_ip}} next-hop-self",
            "  neighbor {{link4_ip2}} remote-as {{as3}}",
            "  no auto-summary"
        ],
        "{{router4_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network 0.0.0.0 255.255.255.255 area 0"
        ],
        "{{router5_name}}": [
            "router bgp {{as3}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router5_lo0_network}} mask {{router5_lo0_mask}}",
            "  neighbor {{link4_ip1}} remote-as {{as2}}",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF within AS {{as2}} ({{router2_name}}, {{router4_name}}, {{router3_name}}) to advertise the Loopback0 interfaces. {{router4_name}} is an AS {{as2}} internal router that runs only OSPF, not BGP. Do not advertise or run OSPF on the links interconnecting AS {{as1}} ({{router1_name}}) and AS {{as3}} ({{router5_name}}).",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "0"
                            },
                            {
                                "interface": "{{router2_link2_iface}}",
                                "area": "0"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "0"
                            },
                            {
                                "interface": "{{router4_link2_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router4_link3_iface}}",
                                "area": "0"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "0"
                            },
                            {
                                "interface": "{{router3_link3_iface}}",
                                "area": "0"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router4_name}}",
                    "command": "show ip route {{link1_network}} {{link1_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "1-5",
                    "node": "{{router4_name}}",
                    "command": "show ip route {{link4_network}} {{link4_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "Configure IBGP between {{router2_name}} and {{router3_name}} (both in AS {{as2}}). Source the BGP updates from their Loopback0 interfaces.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{router3_lo0_ip}}",
                                "remote_as": "{{as2}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{router2_lo0_ip}}",
                                "remote_ip": "{{router3_lo0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{router2_lo0_ip}}",
                                "remote_as": "{{as2}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{router3_lo0_ip}}",
                                "remote_ip": "{{router2_lo0_ip}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Enable BGP synchronization on {{router2_name}} and {{router3_name}}.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show ip protocols | section bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "igp_sync": true
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "igp_sync": true
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router2_name}} (AS {{as2}}) and {{router1_name}} (AS {{as1}}).",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip1}}",
                                "remote_as": "{{as1}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router3_name}} (AS {{as2}}) and {{router5_name}} (AS {{as3}}).",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link4_ip2}}",
                                "remote_as": "{{as3}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Advertise the Loopback0 interfaces on {{router1_name}} (AS {{as1}}) and {{router5_name}} (AS {{as3}}) into BGP.",
            "testcase": [
                {
                    "id": "6-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_lo0_cidr}}",
                                "origin": "i"
                            }
                        ]
                    }
                },
                {
                    "id": "6-2",
                    "node": "{{router5_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router5_lo0_cidr}}",
                                "origin": "i"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Ensure AS {{as1}} and AS {{as3}} can communicate with each other without removing the BGP synchronization command.",
            "testcase": [
                {
                    "id": "7-1",
                    "node": "{{router1_name}}",
                    "command": "ping {{router5_lo0_ip}} source {{router1_lo0_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                },
                {
