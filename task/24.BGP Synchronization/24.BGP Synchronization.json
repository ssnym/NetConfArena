            "attr": "wildcard"
        },
        "router1_lo0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_r1_lo0",
            "attr": "prefixlen"
        },
        "router1_lo0_cidr": {
            "type": "format",
            "template": "{router1_lo0_network}/{router1_lo0_prefix_len}"
