  "testcases": [
    {
      "goal": "Keep the pseudowire settings in one reusable pseudowire class named {{pw_class}} on both PEs, using MPLS encapsulation and Loopback0 as the pseudowire source, and use that class for both services.",
      "testcase": [
        {
          "id": "1-1",
          "node": "{{router3_name}}",
          "command": "show running-config | include pseudowire-class|encapsulation",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "pseudowire-class {{pw_class}}"
              },
              {
                "line": "encapsulation mpls"
              }
            ]
          }
        },
        {
          "id": "1-2",
          "node": "{{router4_name}}",
          "command": "show running-config | include pseudowire-class|encapsulation",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "pseudowire-class {{pw_class}}"
              },
              {
                "line": "encapsulation mpls"
              }
            ]
          }
        },
        {
          "id": "1-3",
          "node": "{{router3_name}}",
          "command": "show running-config | include pseudowire-class",
          "expected_result": {
            "op": "count_match",
            "match": {
              "line": "pseudowire-class {{pw_class}}"
            },
            "count": {
              "op": "==",
              "value": 1
            }
          }
        }
      ]
    },
    {
      "goal": "Carry both services as Ethernet over MPLS pseudowires in port mode over the same pair of PEs: service A with virtual circuit identifier {{vc_id_a}}, service B with {{vc_id_b}}.",
