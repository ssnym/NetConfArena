    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "ip bgp-community new-format"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "ip bgp-community new-format"
        ],
        "{{router3_name}}": [
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router3_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "ip bgp-community new-format"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as3}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  neighbor {{link1_ip2}} route-map CHANGECOMMUNITY in",
            "  no auto-summary",
            "ip community-list 1 permit {{community_delete}}",
            "route-map CHANGECOMMUNITY permit 10",
            "  set comm-list 1 delete",
            "  set community {{community_add}} additive"
        ],
        "{{router2_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router2_loopback0_network}} mask {{router2_loopback0_mask}}",
            "  neighbor {{link2_ip2}} remote-as {{as2}}",
            "  neighbor {{link2_ip2}} send-community both",
            "  neighbor {{link2_ip2}} route-map SETCOMMUNITY out",
            "  no auto-summary",
            "route-map SETCOMMUNITY permit 10",
            "  set community {{community1}} {{community_delete}} {{community3}}"
        ],
        "{{router3_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link2_ip1}} remote-as {{as1}}",
            "  neighbor {{link1_ip1}} remote-as {{as3}}",
            "  neighbor {{link1_ip1}} send-community both",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between AS {{as1}} and AS {{as2}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip1}}",
                        "remote_ip": "{{link2_ip2}}"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "remote_as": "{{as1}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip2}}",
                        "remote_ip": "{{link2_ip1}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between AS {{as2}} and AS {{as3}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip1}}",
                        "remote_as": "{{as3}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip2}}",
                        "remote_ip": "{{link1_ip1}}"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip1}}",
                        "remote_ip": "{{link1_ip2}}"
                    }
                }
            ]
        },
        {
            "goal": "Advertise the loopback0 interface on router {{router2_name}} in BGP.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router2_loopback0_cidr}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router2_name}} so it sends community value {{community1}}, {{community_delete}} and {{community3}} along with the update.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show route-map",
                    "expected_result": {
                        "action": "permit",
                        "set_clauses": [
                            "{{community1}}",
                            "{{community_delete}}",
                            "{{community3}}"
                        ]
                    },
                    "output": "name"
                },
                {
                    "id": "4-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "send_community": true
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}",
                                "communities": {
                                    "op": "contains_all",
                                    "value": [
                                        "{{community1}}",
                                        "{{community_delete}}",
                                        "{{community3}}"
                                    ]
                                }
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router1_name}} to remove community value {{community_delete}} and add {{community_add}} instead.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router1_name}}",
                    "command": "show ip community-list",
                    "expected_result": {
                        "community_type": "standard",
                        "action": "permit",
                        "community": "{{community_delete}}"
                    },
                    "output": "list_number"
                },
                {
                    "id": "5-2",
                    "node": "{{router1_name}}",
                    "command": "show route-map",
                    "expected_result": {
                        "action": "permit",
                        "set_clauses": [
                            "comm-list ",
                            " delete",
                            "community {{community_add}} additive"
                        ]
                    },
                    "output": "name"
                },
                {
                    "id": "5-3",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "inbound_routemap": "$5-2_{{router1_name}}_name$"
                    }
                },
                {
                    "id": "5-4",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip1}}",
                        "send_community": true
                    }
                },
                {
                    "id": "5-5",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}",
                                "communities": {
                                    "op": "contains_all",
                                    "value": [
                                        "{{community1}}",
                                        "{{community3}}",
                                        "{{community_add}}"
                                    ]
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "5-6",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "op": "count_match",
                        "match": {
                            "network": "{{router2_loopback0_cidr}}",
                            "communities": {
                                "op": "contains",
                                "value": "{{community_delete}}"
                            }
                        },
                        "count": {
                            "op": "==",
                            "value": 0
                        }
                    }
                }
            ]
        }
    ]
}
