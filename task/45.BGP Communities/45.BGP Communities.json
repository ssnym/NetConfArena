                "x": -623.869191135,
                "y": -110.308657865,
                "z": -2.0
            }
        ]
    },
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{community_ip1}} {{community_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "ip bgp-community new-format"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{community_ip2}} {{community_mask}}",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "ip bgp-community new-format"
        ],
        "{{router3_name}}": [
            "interface {{router3_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "ip bgp-community new-format"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{community_network}} mask {{community_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{as1}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "access-list 1 permit {{community_network}} {{community_wildcard}}",
            "route-map SEND-COMMUNITY permit 10",
            "  match ip address 1",
            "  set community {{community_value}} additive",
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{community_network}} mask {{community_mask}}",
            "  neighbor {{link2_ip2}} remote-as {{as1}}",
            "  neighbor {{link2_ip2}} send-community",
            "  neighbor {{link2_ip2}} route-map SEND-COMMUNITY out",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "ip community-list 1 permit {{community_value}}",
            "route-map PREFER-COMMUNITY permit 10",
            "  match community 1",
            "  set weight 500",
            "route-map PREFER-COMMUNITY permit 20",
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link1_ip1}} remote-as {{as2}}",
            "  neighbor {{link2_ip1}} remote-as {{as2}}",
            "  neighbor {{link2_ip1}} route-map PREFER-COMMUNITY in",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between router {{router3_name}} and {{router1_name}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip1}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip2}}",
                        "remote_ip": "{{link1_ip1}}"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "remote_as": "{{as1}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip1}}",
                        "remote_ip": "{{link1_ip2}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between router {{router3_name}} and {{router2_name}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip2}}",
                        "remote_ip": "{{link2_ip1}}"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "remote_as": "{{as1}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip1}}",
                        "remote_ip": "{{link2_ip2}}"
                    }
                }
            ]
        },
        {
            "goal": "Advertise the loopback0 interface on router {{router1_name}} and {{router2_name}}.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{community_cidr}}"
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{community_cidr}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router2_name}} to send the community value {{community_value}} for network {{community_network}} /{{community_prefix_len}}.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show route-map",
                    "expected_result": {
                        "action": "permit",
                        "set_clauses": [
                            "community {{community_value}}"
                        ]
                    },
                    "output": "name"
                },
                {
                    "id": "4-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "outbound_routemap": "$4-1_{{router2_name}}_name$",
                        "send_community": true
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp {{community_network}} {{community_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{community_cidr}}",
                                "next_hop": "{{link2_ip1}}",
                                "communities": {
                                    "op": "contains",
                                    "value": "{{community_value}}"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router3_name}} to match on the community value {{community_value}} and send traffic for {{community_network}} /{{community_prefix_len}} to router {{router2_name}}.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router3_name}}",
                    "command": "show ip community-list",
                    "expected_result": {
                        "community_type": "standard",
                        "action": "permit",
                        "community": "{{community_value}}"
                    },
                    "output": "list_number"
                },
                {
                    "id": "5-2",
                    "node": "{{router3_name}}",
                    "command": "show route-map",
                    "expected_result": {
                        "action": "permit",
                        "match_clauses": [
                            "community (community-list filter): $5-1_{{router3_name}}_list_number$"
                        ],
                        "set_clauses": {
                            "op": "not_empty"
                        }
                    },
                    "output": "name"
                },
                {
                    "id": "5-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "inbound_routemap": "$5-2_{{router3_name}}_name$"
                    }
                },
                {
                    "id": "5-4",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{community_cidr}}",
                        "next_hop": "{{link2_ip1}}",
                        "path_selection": ">"
                    }
                }
            ]
        },
        {
            "goal": "All IP addresses have been preconfigured for you.",
            "testcase": []
        }
    ]
}
