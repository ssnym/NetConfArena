{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "as1": {
            "type": "choice",
            "options": "as1_options"
        },
        "as2": {
            "type": "choice",
            "options": "as2_options",
            "different_from": [
                "as1"
            ]
        },
        "community_value": {
            "type": "choice",
            "options": "community_value_options"
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.13.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "_community_net": {
            "type": "random_subnet",
            "pool": "community_pool",
            "prefix_len": "community_prefix_lens",
            "default": "23.23.23.0/24"
        },
        "community_network": {
            "type": "subnet_attr",
            "subnet": "_community_net",
            "attr": "network"
        },
        "community_mask": {
            "type": "subnet_attr",
            "subnet": "_community_net",
            "attr": "netmask"
        },
        "community_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_community_net",
            "attr": "prefixlen"
        },
        "community_wildcard": {
            "type": "subnet_attr",
            "subnet": "_community_net",
            "attr": "wildcard"
        },
        "community_ip1": {
            "type": "subnet_attr",
            "subnet": "_community_net",
            "attr": "host",
            "index": 1
        },
        "community_ip2": {
            "type": "subnet_attr",
            "subnet": "_community_net",
            "attr": "host",
            "index": 2
        },
        "community_cidr": {
            "type": "format",
            "template": "{community_network}/{community_prefix_len}"
        }
    },
    "scenario": "BGP Communities",
    "goals": "• All IP addresses have been preconfigured for you.\n• Configure EBGP between router {{router3_name}} and {{router1_name}}.\n  AS {{as1}}: {{router3_name}}\n  AS {{as2}}: {{router1_name}}, {{router2_name}}\n• Configure EBGP between router {{router3_name}} and {{router2_name}}.\n• Advertise the loopback0 interface on router {{router1_name}} and {{router2_name}}.\n• Configure router {{router2_name}} to send the community value {{community_value}} for network {{community_network}} /{{community_prefix_len}}.\n• Configure router {{router3_name}} to match on the community value {{community_value}} and send traffic for {{community_network}} /{{community_prefix_len}} to router {{router2_name}}.",
    "topology_model": {
        "nodes": [
            "r1",
            "r2",
            "r3"
        ],
        "links": [
            {
                "id": "link1",
                "nodes": [
                    "r1",
                    "r3"
                ],
                "media": "{{link1_media}}"
            },
            {
                "id": "link2",
                "nodes": [
                    "r2",
                    "r3"
                ],
                "media": "{{link2_media}}"
            }
        ]
    },
    "topology_attributes": {
        "nodes": {
