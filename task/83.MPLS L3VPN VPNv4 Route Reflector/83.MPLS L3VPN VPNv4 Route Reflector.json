  "startup_configs": {
    "{{router4_name}}": [
      "interface Loopback0",
      "  ip address {{router4_loopback0_ip}} {{router4_loopback0_mask}}",
      "interface {{router4_link1_iface}}",
      "  ip address {{link1_ip1}} {{link1_mask}}",
      "  no shutdown",
      "interface {{router4_link2_iface}}",
      "  ip address {{link2_ip1}} {{link2_mask}}",
      "  no shutdown",
      "interface {{router4_link3_iface}}",
      "  ip address {{link3_ip1}} {{link3_mask}}",
      "  no shutdown",
      "router ospf 1",
      "  router-id {{router4_loopback0_ip}}",
      "  network {{router4_loopback0_ip}} 0.0.0.0 area 0",
      "  network {{link1_network}} {{link1_wildcard}} area 0",
      "  network {{link2_network}} {{link2_wildcard}} area 0",
      "  network {{link3_network}} {{link3_wildcard}} area 0",
      "mpls label protocol ldp",
      "mpls ldp router-id Loopback0 force",
      "interface {{router4_link1_iface}}",
      "  mpls ip",
      "interface {{router4_link2_iface}}",
      "  mpls ip",
      "interface {{router4_link3_iface}}",
      "  mpls ip"
    ],
    "{{router1_name}}": [
      "interface Loopback0",
      "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
      "interface {{router1_link1_iface}}",
      "  ip address {{link1_ip2}} {{link1_mask}}",
      "  no shutdown",
      "router ospf 1",
      "  router-id {{router1_loopback0_ip}}",
      "  network {{router1_loopback0_ip}} 0.0.0.0 area 0",
      "  network {{link1_network}} {{link1_wildcard}} area 0",
      "mpls label protocol ldp",
      "mpls ldp router-id Loopback0 force",
      "interface {{router1_link1_iface}}",
      "  mpls ip",
      "ip vrf {{vrf_name}}",
      "  rd {{rd1}}",
      "  route-target export {{rt}}",
      "  route-target import {{rt}}",
      "interface Loopback1",
      "  ip vrf forwarding {{vrf_name}}",
      "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}"
    ],
    "{{router2_name}}": [
