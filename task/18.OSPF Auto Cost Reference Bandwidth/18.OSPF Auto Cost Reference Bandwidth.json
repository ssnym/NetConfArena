    "scenario": "OSPF Auto Cost Reference Bandwidth",
    "goals": "• Configure OSPF on all routers. Achieve full connectivity.\n• Without changing the OSPF cost on each interface, ensure OSPF will make the best use of the Gigabit interfaces. In the future you will also add some 10 Gigabit (10G) links so this is something to be aware of.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown",
            "interface {{router2_link5_iface}}",
