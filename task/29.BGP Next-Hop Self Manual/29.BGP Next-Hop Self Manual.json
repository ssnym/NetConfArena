    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback_ip}} {{router1_loopback_mask}}",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{router1_loopback_network}} {{router1_loopback_wildcard}} area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router2_loopback1_ip}} {{router2_loopback1_mask}}",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback_ip}} {{router3_loopback_mask}}",
            "interface {{router3_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{router3_loopback_network}} {{router3_loopback_wildcard}} area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{link1_network}}",
            "  neighbor {{router3_loopback_ip}} remote-as {{as1}}",
            "  neighbor {{router3_loopback_ip}} update-source Loopback0",
            "  neighbor {{link2_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router2_loopback0_network}} mask {{router2_loopback0_mask}}",
            "  network {{router2_loopback1_network}} mask {{router2_loopback1_mask}}",
            "  neighbor {{link2_ip1}} remote-as {{as1}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router1_loopback_ip}} remote-as {{as1}}",
            "  neighbor {{router1_loopback_ip}} update-source Loopback0",
            "  neighbor {{router1_loopback_ip}} route-map BGPNEXTHOP in",
            "  no auto-summary",
            "route-map BGPNEXTHOP permit 10",
            "  set ip next-hop {{router1_loopback_ip}}"
        ]
    },
    "testcases": [
        {
            "goal": "Configure IBGP between router {{router1_name}} and {{router3_name}}, use AS {{as1}}, and use their Loopback0 interfaces as the BGP source.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{router3_loopback_ip}}",
                        "remote_as": "{{as1}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{router1_loopback_ip}}",
                        "remote_ip": "{{router3_loopback_ip}}"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{router1_loopback_ip}}",
                        "remote_as": "{{as1}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{router3_loopback_ip}}",
                        "remote_ip": "{{router1_loopback_ip}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between router {{router1_name}} and {{router2_name}} in AS {{as2}}.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established"
                    }
                }
            ]
        },
        {
            "goal": "Ensure both BGP neighbor relationships are up.",
            "testcase": []
        },
        {
            "goal": "Router {{router1_name}}: Advertise the {{link1_network}}/{{link1_prefix_len}} network into BGP.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{link1_network}}",
                                "origin": "i"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Router {{router2_name}}: Advertise the {{router2_loopback0_cidr}} network on Loopback0 into BGP.",
            "testcase": [
                {
                    "id": "4",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router2_loopback0_cidr}}",
                        "origin": "i"
                    }
                }
            ]
        },
        {
            "goal": "Router {{router2_name}}: Advertise the {{router2_loopback1_cidr}} network on Loopback1 into BGP.",
            "testcase": [
                {
                    "id": "5",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router2_loopback1_cidr}}",
                        "origin": "i"
                    }
                }
            ]
        },
        {
            "goal": "Ensure router {{router3_name}} can reach {{router2_name}}'s Loopback0 ({{router2_loopback0_cidr}}) and Loopback1 ({{router2_loopback1_cidr}}) networks by modifying the BGP next-hop attribute on router {{router1_name}} when advertising prefixes to {{router3_name}}. You are not allowed to use static routes or the BGP next-hop-self command.",
            "testcase": [
                {
                    "id": "6-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp {{link2_network}}/{{link2_prefix_len}}",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "6-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | section ip route",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "6-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}",
                                "next_hop": {"op": "in", "value": ["{{router1_loopback_ip}}", "{{link1_ip1}}"]}
                            },
                            {
                                "network": "{{router2_loopback1_cidr}}",
                                "next_hop": {"op": "in", "value": ["{{router1_loopback_ip}}", "{{link1_ip1}}"]}
                            }
                        ]
                    }
                },
                {
                    "id": "6-4",
                    "node": "{{router3_name}}",
                    "command": "ping {{router2_loopback0_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                },
                {
                    "id": "6-5",
                    "node": "{{router3_name}}",
                    "command": "ping {{router2_loopback1_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                }
            ]
        }
    ]
}
