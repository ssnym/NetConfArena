{
    "params": {
        "as1": {
            "type": "choice",
            "options": "as1_options",
            "default": "100"
        },
        "as2": {
            "type": "choice",
            "options": "as2_options",
            "default": "200",
            "different_from": [
                "as1"
            ]
        },
        "router1_name": {
            "type": "choice",
            "options": "r1_names",
            "default": "HanSolo"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "default": "Leia",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "default": "Luke",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "_loopback1": {
            "type": "random_subnet",
            "pool": "r1_loopback_pool",
            "prefix_len": "r1_loopback_prefix_lens",
            "default": "1.1.1.0/24"
        },
        "router1_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "host",
            "index": 1
        },
        "router1_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "network"
        },
        "router1_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "netmask"
        },
        "router1_loopback_wildcard": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "wildcard"
        },
        "router1_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "prefixlen"
        },
        "router1_loopback_cidr": {
            "type": "format",
            "template": "{router1_loopback_network}/{router1_loopback_prefix_len}"
        },
        "_loopback2_0": {
            "type": "random_subnet",
            "pool": "r2_loopback0_pool",
            "prefix_len": "r2_loopback0_prefix_lens",
            "default": "3.3.3.0/24"
        },
        "router2_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback2_0",
            "attr": "host",
            "index": 3
        },
        "router2_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_loopback2_0",
            "attr": "network"
        },
        "router2_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback2_0",
            "attr": "netmask"
        },
        "router2_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback2_0",
            "attr": "prefixlen"
        },
        "router2_loopback0_cidr": {
            "type": "format",
            "template": "{router2_loopback0_network}/{router2_loopback0_prefix_len}"
        },
        "_loopback2_1": {
            "type": "random_subnet",
            "pool": "r2_loopback1_pool",
            "prefix_len": "r2_loopback1_prefix_lens",
            "default": "33.33.33.0/24"
        },
        "router2_loopback1_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback2_1",
            "attr": "host",
            "index": 33
        },
        "router2_loopback1_network": {
            "type": "subnet_attr",
            "subnet": "_loopback2_1",
            "attr": "network"
        },
        "router2_loopback1_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback2_1",
            "attr": "netmask"
        },
        "router2_loopback1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback2_1",
            "attr": "prefixlen"
        },
        "router2_loopback1_cidr": {
            "type": "format",
            "template": "{router2_loopback1_network}/{router2_loopback1_prefix_len}"
        },
        "_loopback3": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": "r3_loopback_prefix_lens",
            "default": "2.2.2.0/24"
        },
        "router3_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "host",
            "index": 2
        },
        "router3_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "network"
        },
        "router3_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "netmask"
        },
        "router3_loopback_wildcard": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "wildcard"
        },
        "router3_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "prefixlen"
        },
        "router3_loopback_cidr": {
            "type": "format",
            "template": "{router3_loopback_network}/{router3_loopback_prefix_len}"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.13.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 3
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        }
    },
    "scenario": "BGP Next-Hop Self Manual",
    "goals": "\u2022 Configure IBGP between router {{router1_name}} and {{router3_name}}, use AS {{as1}}, and use their Loopback0 interfaces as the BGP source.\n\u2022 Configure EBGP between router {{router1_name}} and {{router2_name}} in AS {{as2}}.\n\u2022 Ensure both BGP neighbor relationships are up.\n\u2022 Router {{router1_name}}: Advertise the {{link1_network}}/{{link1_prefix_len}} network into BGP.\n\u2022 Router {{router2_name}}: Advertise the {{router2_loopback0_cidr}} network on Loopback0 into BGP.\n\u2022 Router {{router2_name}}: Advertise the {{router2_loopback1_cidr}} network on Loopback1 into BGP.\n\u2022 Ensure router {{router3_name}} can reach {{router2_name}}'s Loopback0 ({{router2_loopback0_cidr}}) and Loopback1 ({{router2_loopback1_cidr}}) networks by modifying the BGP next-hop attribute on router {{router1_name}} when advertising prefixes to {{router3_name}}. You are not allowed to use static routes or the BGP next-hop-self command.",
    "topology_model": {
