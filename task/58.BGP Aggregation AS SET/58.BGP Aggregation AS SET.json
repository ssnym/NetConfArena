    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{router1_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  network {{router1_loopback1_network}} mask {{router1_loopback1_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{router2_as}}",
            "  neighbor {{link2_ip2}} remote-as {{router3_as}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{router2_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  aggregate-address {{summary_network}} {{summary_mask}} as-set summary-only",
            "  neighbor {{link1_ip1}} remote-as {{router1_as}}",
            "  neighbor {{link3_ip2}} remote-as {{router3_as}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router bgp {{router3_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link2_ip1}} remote-as {{router1_as}}",
            "  neighbor {{link3_ip1}} remote-as {{router2_as}}",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between {{router3_name}} and {{router2_name}}.",
            "testcase": [
                {
                    "id": "1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link3_ip1}}",
                                "remote_as": "{{router2_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link3_ip2}}",
                                "remote_ip": "{{link3_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router2_name}} and {{router1_name}}.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip1}}",
                                "remote_as": "{{router1_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link1_ip2}}",
                                "remote_ip": "{{link1_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router3_name}} and {{router1_name}}.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip1}}",
                                "remote_as": "{{router1_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link2_ip2}}",
                                "remote_ip": "{{link2_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Advertise the networks on the loopback interfaces on router {{router1_name}}.",
            "testcase": [
        {
          "id": "4",
          "node": "{{router1_name}}",
          "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_cidr}}"
                            },
                            {
                                "network": "{{router1_loopback1_cidr}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Create a summary on router {{router2_name}} that aggregates to network {{summary_network}} / {{summary_prefix_len}}.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include aggregate-address",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "aggregate-address {{summary_network}} {{summary_mask}} as-set summary-only"
                            }
                        ]
                    }
                },
        {
          "id": "5-2",
          "node": "{{router2_name}}",
          "command": "show ip bgp {{summary_network}} {{summary_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
              {
                "network": "{{summary_cidr}}",
                "next_hop": "0.0.0.0"
              }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Ensure AS {{router1_as}} does not install this summary in its BGP table. You are not allowed to use any filters or prefix/access-lists.",
            "testcase": [
                {
                    "id": "6-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp {{summary_network}} {{summary_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "6-2",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include prefix-list",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "6-3",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include access-list",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
