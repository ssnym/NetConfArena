{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router1_as": {
            "type": "choice",
            "options": "r1_as_options"
        },
        "router2_as": {
            "type": "choice",
            "options": "r2_as_options",
            "different_from": [
                "router1_as"
            ]
        },
        "router3_as": {
            "type": "choice",
            "options": "r3_as_options",
            "different_from": [
                "router1_as",
                "router2_as"
            ]
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "link3_media": {
            "type": "choice",
            "options": "link3_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.23.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.13.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_cidr": {
            "type": "format",
            "template": "{link2_network}/{link2_prefix_len}"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "_link3": {
            "type": "random_subnet",
            "pool": "link3_pool",
            "prefix_len": "link3_prefix_lens",
            "default": "192.168.12.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "link3_network": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "network"
        },
        "link3_mask": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "netmask"
        },
        "link3_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "prefixlen"
        },
        "link3_cidr": {
            "type": "format",
            "template": "{link3_network}/{link3_prefix_len}"
        },
        "link3_ip1": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 1
        },
        "link3_ip2": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 2
        },
        "_router1_loopback_summary": {
            "type": "random_subnet",
            "pool": "r1_loopback_summary_pool",
            "prefix_len": "r1_loopback_summary_prefix_lens",
            "default": "172.16.0.0/16",
            "no_overlap": [
                "_link1",
                "_link2",
                "_link3"
            ]
        },
        "summary_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback_summary",
            "attr": "network"
        },
        "summary_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback_summary",
            "attr": "netmask"
        },
        "summary_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback_summary",
            "attr": "prefixlen"
        },
        "summary_cidr": {
            "type": "format",
            "template": "{summary_network}/{summary_prefix_len}"
        },
        "router1_loopback0_network": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 0,
            "attr": "network"
        },
        "router1_loopback0_mask": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 0,
            "attr": "netmask"
        },
        "router1_loopback0_prefix_len": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 0,
            "attr": "prefixlen"
        },
        "router1_loopback0_ip": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 0,
            "attr": "host",
            "index": 1
        },
        "router1_loopback0_cidr": {
            "type": "format",
            "template": "{router1_loopback0_network}/{router1_loopback0_prefix_len}"
        },
        "router1_loopback1_network": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 1,
            "attr": "network"
        },
        "router1_loopback1_mask": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 1,
            "attr": "netmask"
        },
        "router1_loopback1_prefix_len": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 1,
            "attr": "prefixlen"
        },
        "router1_loopback1_ip": {
            "type": "subnet_nth",
            "subnet": "_router1_loopback_summary",
            "new_prefix": 24,
            "n": 1,
            "attr": "host",
            "index": 1
        },
        "router1_loopback1_cidr": {
            "type": "format",
            "template": "{router1_loopback1_network}/{router1_loopback1_prefix_len}"
        }
    },
    "scenario": "BGP Aggregation AS SET",
    "goals": "• Configure EBGP between {{router3_name}} and {{router2_name}}.\n  AS {{router1_as}}: {{router1_name}}\n  AS {{router2_as}}: {{router2_name}}\n  AS {{router3_as}}: {{router3_name}}\n• Configure EBGP between {{router2_name}} and {{router1_name}}.\n• Configure EBGP between {{router3_name}} and {{router1_name}}.\n• Advertise the networks on the loopback interfaces on router {{router1_name}}.\n• Create a summary on router {{router2_name}} that aggregates to network {{summary_network}} / {{summary_prefix_len}}.\n• Ensure AS {{router1_as}} does not install this summary in its BGP table. You are not allowed to use any filters or prefix/access-lists.",
