    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router4_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as3}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router2_loopback0_network}} mask {{router2_loopback0_mask}}",
            "  neighbor {{link2_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link3_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router4_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link2_ip1}} remote-as {{as1}}",
            "  neighbor {{link2_ip1}} route-map NOEXPORT in",
            "  neighbor {{link3_ip1}} remote-as {{as2}}",
            "  neighbor {{link3_ip1}} next-hop-self",
            "  neighbor {{link3_ip1}} send-community both",
            "  neighbor {{link1_ip1}} remote-as {{as3}}",
            "  no auto-summary",
            "access-list 1 permit {{router2_loopback0_network}} {{router2_loopback0_wildcard}}",
            "route-map NOEXPORT permit 10",
            "  match ip address 1",
            "  set community no-export"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between AS {{as1}} and AS {{as2}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip1}}",
                        "remote_ip": "{{link2_ip2}}"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "remote_as": "{{as1}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip2}}",
                        "remote_ip": "{{link2_ip1}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between AS {{as2}} and AS {{as3}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip1}}",
                        "remote_as": "{{as3}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip2}}",
                        "remote_ip": "{{link1_ip1}}"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip1}}",
                        "remote_ip": "{{link1_ip2}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure IBGP in AS {{as2}}.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link3_ip1}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link3_ip2}}",
                        "remote_ip": "{{link3_ip1}}"
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link3_ip2}}",
                        "remote_as": "{{as2}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link3_ip1}}",
                        "remote_ip": "{{link3_ip2}}"
                    }
                }
            ]
        },
        {
            "goal": "Advertise the loopback0 interface on router {{router2_name}} in BGP.",
            "testcase": [
                {
                    "id": "4",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router2_loopback0_cidr}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router4_name}} so network {{router2_loopback0_network}} /{{router2_loopback0_prefix_len}} is known within AS {{as2}} but will never be advertised to any other autonomous systems. Use one of the communities to achieve this.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router3_name}}",
                    "command": "show ip route {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "network": "{{router2_loopback0_cidr}}",
                        "protocol": "bgp"
                    }
                },
                {
                    "id": "5-2",
                    "node": "{{router4_name}}",
                    "command": "show route-map",
                    "expected_result": {
                        "action": "permit",
                        "set_clauses": [
                            "community no-export"
                        ]
                    },
                    "output": "name"
                },
                {
                    "id": "5-3",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "inbound_routemap": "$5-2_{{router4_name}}_name$"
                    }
                },
                {
                    "id": "5-4",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}",
                                "communities": {
                                    "op": "contains",
                                    "value": "no-export"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "5-5",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}",
                                "communities": {
                                    "op": "contains",
                                    "value": "no-export"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "5-6",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp {{router2_loopback0_network}} {{router2_loopback0_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
