            "  ip nhrp nhs {{nbma_ip1}}",
            "router eigrp {{eigrp_asn}}",
            "  network {{nbma_network}} {{nbma_wildcard}}",
            "  network {{router3_loopback1_network}} {{router3_loopback1_wildcard}}",
            "  no auto-summary"
        ]
    },
    "groundtruth_configs": {
        "{{router2_name}}": [
            "interface Tunnel{{tunnel_id}}",
            "  no tunnel destination",
            "  tunnel mode gre multipoint",
            "  ip nhrp map {{nbma_ip1}} {{link1_ip1}}",
            "  ip nhrp map multicast {{link1_ip1}}"
        ],
        "{{router3_name}}": [
            "interface Tunnel{{tunnel_id}}",
            "  no tunnel destination",
            "  tunnel mode gre multipoint",
            "  ip nhrp map {{nbma_ip1}} {{link1_ip1}}",
            "  ip nhrp map multicast {{link1_ip1}}"
        ],
        "{{router1_name}}": [
            "interface Tunnel{{tunnel_id}}",
            "  no ip next-hop-self eigrp {{eigrp_asn}}"
        ]
    },
    "testcases": [
        {
            "goal": "On both spokes, replace the fixed point to point tunnel with a multipoint GRE tunnel that keeps registering with the hub and still maps multicast traffic to {{link1_ip1}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include tunnel mode gre multipoint",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel mode gre multipoint"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include tunnel mode gre multipoint",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel mode gre multipoint"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include tunnel destination",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include tunnel destination",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "1-5",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include ip nhrp nhs|ip nhrp map multicast",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "ip nhrp nhs {{nbma_ip1}}"
                            },
                            {
                                "line": "ip nhrp map multicast {{link1_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "On the hub, stop replacing the next hop in the EIGRP updates it relays between the spokes.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include next-hop-self",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "no ip next-hop-self eigrp {{eigrp_asn}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip eigrp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "as": "{{eigrp_asn}}",
                                "ip_address": "{{nbma_ip2}}"
                            },
                            {
                                "as": "{{eigrp_asn}}",
                                "ip_address": "{{nbma_ip3}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Do not change the tunnel addresses, the tunnel key, the NHRP network identifier, the NHRP authentication or the EIGRP AS number.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include tunnel key|ip nhrp network-id|ip nhrp authentication",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel key {{nhrp_network_id}}"
                            },
                            {
                                "line": "ip nhrp network-id {{nhrp_network_id}}"
                            },
                            {
                                "line": "ip nhrp authentication {{nhrp_auth}}"
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include ip address {{nbma_ip2}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": {
                                    "op": "contains",
                                    "value": "{{nbma_ip2}}"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "{{router2_name}} must reach {{router3_loopback1_cidr}} with next hop {{nbma_ip3}}, {{router3_name}} must reach {{router2_loopback1_cidr}} with next hop {{nbma_ip2}}, and the two private networks must still be able to ping each other.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show ip route {{router3_loopback1_network}} {{router3_loopback1_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router3_loopback1_cidr}}",
                                "protocol": "eigrp",
                                "nexthop_ip": "{{nbma_ip3}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router3_name}}",
                    "command": "show ip route {{router2_loopback1_network}} {{router2_loopback1_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback1_cidr}}",
                                "protocol": "eigrp",
                                "nexthop_ip": "{{nbma_ip2}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router2_name}}",
                    "command": "ping {{router3_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "4-4",
                    "node": "{{router3_name}}",
                    "command": "ping {{router2_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
