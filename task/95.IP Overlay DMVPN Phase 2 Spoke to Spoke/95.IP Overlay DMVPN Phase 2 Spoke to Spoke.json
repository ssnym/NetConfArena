    "startup_configs": {
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback0_ip}} {{router4_loopback0_mask}}",
            "interface {{router4_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "ip route 0.0.0.0 0.0.0.0 {{link1_ip2}}",
            "interface Tunnel{{tunnel_id}}",
            "  ip address {{nbma_ip1}} {{nbma_mask}}",
            "  tunnel source {{router1_link1_iface}}",
            "  tunnel key {{nhrp_network_id}}",
            "  ip nhrp authentication {{nhrp_auth}}",
            "  ip nhrp network-id {{nhrp_network_id}}",
