    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_network}} {{router1_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_network}} {{router2_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router2_loopback1_ip}} {{router2_loopback1_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{router1_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  network {{router1_loopback1_network}} mask {{router1_loopback1_mask}}",
            "  aggregate-address {{summary_network}} {{summary_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{router2_as}}",
            "  neighbor {{link1_ip2}} distribute-list {{router1_acl_number}} in",
            "  no auto-summary",
            "access-list {{router1_acl_number}} deny ip host {{router2_loopback1_network}} host {{router2_loopback1_mask}}",
            "access-list {{router1_acl_number}} permit ip any any"
        ],
        "{{router2_name}}": [
            "router bgp {{router2_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router2_loopback0_network}} mask {{router2_loopback0_mask}}",
            "  network {{router2_loopback1_network}} mask {{router2_loopback1_mask}}",
            "  neighbor {{link1_ip1}} remote-as {{router1_as}}",
            "  neighbor {{link1_ip1}} distribute-list {{router2_acl_number}} in",
            "  no auto-summary",
            "access-list {{router2_acl_number}} deny ip host {{summary_network}} host {{summary_mask}}",
            "access-list {{router2_acl_number}} permit ip any any"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between router {{router1_name}} and {{router2_name}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "remote_as": "{{router2_as}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip1}}",
                        "remote_ip": "{{link1_ip2}}"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip1}}",
                        "remote_as": "{{router1_as}}",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip2}}",
                        "remote_ip": "{{link1_ip1}}"
                    }
                }
            ]
        },
        {
            "goal": "Advertise the loopback interfaces on both routers in BGP.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_network}}/{{router1_loopback0_prefix_len}}"
                            },
                            {
                                "network": "{{router1_loopback1_network}}/{{router1_loopback1_prefix_len}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_network}}/{{router2_loopback0_prefix_len}}"
                            },
                            {
                                "network": "{{router2_loopback1_network}}/{{router2_loopback1_prefix_len}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure a summary that advertises {{summary_network}}/{{summary_prefix_len}} towards router {{router2_name}}.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{summary_network}}"
                    }
                }
            ]
        },
        {
            "goal": "Configure an extended access-list on router {{router2_name}} that will block the {{summary_network}}/{{summary_prefix_len}} prefix but allows all other prefixes.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_type": "Extended",
                        "action": "deny",
                        "protocol": "ip",
                        "src_host": "{{summary_network}}",
                        "dst_host": "{{summary_mask}}"
                    },
                    "output": "acl_name"
                },
                {
                    "id": "4-2",
                    "node": "{{router2_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_name": "$4-1_{{router2_name}}_acl_name$",
                        "acl_type": "Extended",
                        "action": "permit",
                        "protocol": "ip",
                        "src_any": "any",
                        "dst_any": "any"
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp {{summary_network}} {{summary_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "Configure an extended access-list on router {{router1_name}} that blocks network {{router2_loopback1_network}}/{{router2_loopback1_prefix_len}}.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router1_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_type": "Extended",
                        "action": "deny",
                        "protocol": "ip",
                        "src_host": "{{router2_loopback1_network}}",
                        "dst_host": "{{router2_loopback1_mask}}"
                    },
                    "output": "acl_name"
                },
                {
                    "id": "5-2",
                    "node": "{{router1_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_name": "$5-1_{{router1_name}}_acl_name$",
                        "acl_type": "Extended",
                        "action": "permit",
                        "protocol": "ip",
                        "src_any": "any",
                        "dst_any": "any"
                    }
                },
                {
                    "id": "5-3",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp {{router2_loopback1_network}} {{router2_loopback1_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
