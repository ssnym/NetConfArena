{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router1_as": {
            "type": "choice",
            "options": "as_options"
        },
        "router2_as": {
            "type": "choice",
            "options": "as_options",
            "different_from": [
                "router1_as"
            ]
        },
        "router1_acl_number": {
            "type": "choice",
            "options": "extended_acl_numbers"
        },
        "router2_acl_number": {
            "type": "choice",
            "options": "extended_acl_numbers"
        },
        "summary_network": {
            "type": "choice",
            "options": "summary_networks"
        },
        "summary_mask": {
            "type": "choice",
            "options": "summary_masks"
        },
        "summary_prefix_len": {
            "type": "choice",
            "options": "summary_prefix_lens"
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "_router1_loopback0": {
            "type": "random_subnet",
            "pool": "r1_loopback0_pool",
            "prefix_len": "r1_loopback0_prefix_lens",
            "default": "1.1.1.1/32",
            "no_overlap": [
                "_link1"
            ]
        },
        "router1_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "network"
        },
        "router1_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "netmask"
        },
        "router1_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "prefixlen"
        },
        "router1_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "wildcard"
        },
        "router1_loopback0_cidr": {
            "type": "format",
            "template": "{router1_loopback0_network}/{router1_loopback0_prefix_len}"
        },
        "router1_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router1_loopback1": {
            "type": "random_subnet",
            "pool": "r1_loopback1_pool",
            "prefix_len": "r1_loopback1_prefix_lens",
            "default": "10.1.1.0/24",
            "no_overlap": [
                "_link1",
                "_router1_loopback0"
            ]
        },
        "router1_loopback1_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback1",
            "attr": "network"
        },
        "router1_loopback1_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback1",
            "attr": "netmask"
        },
        "router1_loopback1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback1",
            "attr": "prefixlen"
        },
        "router1_loopback1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback1",
            "attr": "wildcard"
        },
        "router1_loopback1_cidr": {
            "type": "format",
            "template": "{router1_loopback1_network}/{router1_loopback1_prefix_len}"
        },
        "router1_loopback1_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback1",
            "attr": "host",
            "index": 1
        },
        "_router2_loopback0": {
            "type": "random_subnet",
            "pool": "r2_loopback0_pool",
            "prefix_len": "r2_loopback0_prefix_lens",
            "default": "2.2.2.2/32",
            "no_overlap": [
                "_link1",
                "_router1_loopback0",
                "_router1_loopback1"
            ]
        },
        "router2_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "network"
        },
        "router2_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "netmask"
        },
        "router2_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "prefixlen"
        },
        "router2_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "wildcard"
        },
        "router2_loopback0_cidr": {
            "type": "format",
            "template": "{router2_loopback0_network}/{router2_loopback0_prefix_len}"
        },
        "router2_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router2_loopback1": {
            "type": "random_subnet",
            "pool": "r2_loopback1_pool",
            "prefix_len": "r2_loopback1_prefix_lens",
            "default": "10.2.2.0/24",
            "no_overlap": [
                "_link1",
                "_router1_loopback0",
                "_router1_loopback1",
                "_router2_loopback0"
            ]
        },
        "router2_loopback1_network": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback1",
            "attr": "network"
        },
        "router2_loopback1_mask": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback1",
            "attr": "netmask"
        },
        "router2_loopback1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback1",
            "attr": "prefixlen"
        },
        "router2_loopback1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback1",
            "attr": "wildcard"
        },
        "router2_loopback1_cidr": {
            "type": "format",
            "template": "{router2_loopback1_network}/{router2_loopback1_prefix_len}"
        },
        "router2_loopback1_ip": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback1",
            "attr": "host",
            "index": 1
        }
    },
    "scenario": "BGP Filtering Extended Access-List",
    "goals": "• Configure EBGP between router {{router1_name}} and {{router2_name}}.\n  AS {{router1_as}}: {{router1_name}}\n  AS {{router2_as}}: {{router2_name}}\n• Advertise the loopback interfaces on both routers in BGP.\n• Configure a summary that advertises {{summary_network}}/{{summary_prefix_len}} towards router {{router2_name}}.\n• Configure an extended access-list on router {{router2_name}} that will block the {{summary_network}}/{{summary_prefix_len}} prefix but allows all other prefixes.\n• Configure an extended access-list on router {{router1_name}} that blocks network {{router2_loopback1_network}}/{{router2_loopback1_prefix_len}}.",
    "topology_model": {
        "nodes": [
            "r1",
            "r2"
        ],
        "links": [
            {
                "id": "link1",
                "nodes": [
                    "r1",
                    "r2"
                ],
                "media": "{{link1_media}}"
            }
        ]
    },
    "topology_attributes": {
        "nodes": {
            "r1": {
                "type": "C3600",
                "label": {
