    "scenario": "RIP Filtering",
    "goals": "• Configure RIP version 2 on all routers, achieve full connectivity for all networks (including the loopbacks).\n• Create a prefix-list so router {{router1_name}} doesn't advertise its loopback0 interface to router {{router3_name}}.\n• Create an access-list so router {{router2_name}} doesn't accept network {{router4_loopback_network}}/{{router4_loopback_prefix_len}}.\n• Create an offset-list so router {{router3_name}} doesn't accept network {{router2_loopback_network}}/{{router2_loopback_prefix_len}}.\n• Change the AD (Administrative Distance) so router {{router4_name}} doesn't place network {{router1_loopback_network}}/{{router1_loopback_prefix_len}} in its routing table.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback_ip}} {{router1_loopback_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback_ip}} {{router2_loopback_mask}}",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router2_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback_ip}} {{router3_loopback_mask}}",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback_ip}} {{router4_loopback_mask}}",
            "interface {{router4_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router rip",
            "  version 2",
            "  network 0.0.0.0",
            "  distribute-list prefix NOLOOPBACK out {{router1_link2_iface}}",
            "  no auto-summary",
            "ip prefix-list NOLOOPBACK seq 5 deny {{router1_loopback_network}}/{{router1_loopback_prefix_len}}",
            "ip prefix-list NOLOOPBACK seq 10 permit 0.0.0.0/0 le 32"
        ],
        "{{router2_name}}": [
            "router rip",
            "  version 2",
            "  network 0.0.0.0",
            "  distribute-list 1 in",
            "  no auto-summary",
            "access-list 1 deny {{router4_loopback_network}} {{router4_loopback_wildcard}}",
            "access-list 1 permit any"
        ],
        "{{router3_name}}": [
            "router rip",
            "  version 2",
            "  offset-list 2 in 16",
            "  network 0.0.0.0",
            "  no auto-summary",
            "access-list 2 permit {{router2_loopback_network}} {{router2_loopback_wildcard}}"
        ],
        "{{router4_name}}": [
            "router rip",
            "  version 2",
            "  network 0.0.0.0",
            "  distance 255 0.0.0.0 255.255.255.255 3",
            "  no auto-summary",
            "access-list 3 permit {{router1_loopback_network}} {{router1_loopback_wildcard}}"
        ]
    },
    "testcases": [
        {
            "goal": "Configure RIP version 2 on all routers, achieve full connectivity for all networks (including the loopbacks).",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router4_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{router4_loopback_network}}/{{router4_loopback_prefix_len}}",
                            "{{link1_network}}/{{link1_prefix_len}}",
                            "{{link3_network}}/{{link3_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{router1_loopback_network}}/{{router1_loopback_prefix_len}}",
                            "{{link1_network}}/{{link1_prefix_len}}",
                            "{{link2_network}}/{{link2_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router2_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{router2_loopback_network}}/{{router2_loopback_prefix_len}}",
                            "{{link3_network}}/{{link3_prefix_len}}",
                            "{{link4_network}}/{{link4_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{router3_loopback_network}}/{{router3_loopback_prefix_len}}",
                            "{{link2_network}}/{{link2_prefix_len}}",
                            "{{link4_network}}/{{link4_prefix_len}}"
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Create a prefix-list so router {{router1_name}} doesn't advertise its loopback0 interface to router {{router3_name}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "auto_summary": {"op": "==", "value": false}
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip prefix-list",
                    "expected_result": {
                        "action": {"op": "==", "value": "deny"},
                        "network": {"op": "==", "value": "{{router1_loopback_network}}"},
                        "netmask": {"op": "==", "value": "{{router1_loopback_prefix_len}}"}
                    },
                    "output": "name"
                },
                {
                    "id": "2-3",
                    "node": "{{router1_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "outgoing_update_filter": {
                            "op": "contains_all",
                            "value": [
                                "{{router1_link2_iface}} filtered by (prefix-list) $2-2_{{router1_name}}_name$"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Create an access-list so router {{router2_name}} doesn't accept network {{router4_loopback_network}}/{{router4_loopback_prefix_len}}.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_type": {"op": "==", "value": "Standard"},
                        "action": {"op": "==", "value": "deny"},
                        "src_network": {"op": "==", "value": "{{router4_loopback_network}}"},
                        "src_wildcard": {"op": "==", "value": "{{router4_loopback_wildcard}}"}
                    },
                    "output": "acl_name"
                },
                {
                    "id": "3-2",
                    "node": "{{router2_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "incoming_update_filter": {
                            "op": "contains_all",
                            "value": [
                                "Incoming update filter list for all interfaces is $3-1_{{router2_name}}_acl_name$"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Create an offset-list so router {{router3_name}} doesn't accept network {{router2_loopback_network}}/{{router2_loopback_prefix_len}}.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router3_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_type": {"op": "==", "value": "Standard"},
                        "action": {"op": "==", "value": "permit"},
                        "src_network": {"op": "==", "value": "{{router2_loopback_network}}"},
                        "src_wildcard": {"op": "==", "value": "{{router2_loopback_wildcard}}"}
                    },
                    "output": "acl_name"
                },
                {
                    "id": "4-2",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "incoming_metric": {
                            "op": "contains_all",
                            "value": [
                                "Incoming routes will have 16 added to metric if on list $4-1_{{router3_name}}_acl_name$"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Change the AD (Administrative Distance) so router {{router4_name}} doesn't place network {{router1_loopback_network}}/{{router1_loopback_prefix_len}} in its routing table.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router4_name}}",
                    "command": "show ip access-lists",
                    "expected_result": {
                        "acl_type": {"op": "==", "value": "Standard"},
                        "action": {"op": "==", "value": "permit"},
                        "src_network": {"op": "==", "value": "{{router1_loopback_network}}"},
                        "src_wildcard": {"op": "==", "value": "{{router1_loopback_wildcard}}"}
                    },
                    "output": "acl_name"
                },
                {
                    "id": "5-2",
                    "node": "{{router4_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "distance_overrides": {
                            "op": "contains_all",
                            "value": [
                                "0.0.0.0         255.255.255.255      255  $5-1_{{router4_name}}_acl_name$"
                            ]
                        }
                    }
                }
            ]
        }
    ],
