    "scenario": "RIP Offset List",
    "goals": "• Configure RIP version 2 on all routers and make sure you have full connectivity. Advertise all loopback interfaces on router {{router2_name}}.\n• You are only allowed to use offset-lists for this lab.\n• Ensure router {{router1_name}}, {{router4_name}} and {{router3_name}} use the {{router2_link3_iface}} link on router {{router2_name}} to reach network {{loopback0_network}}/{{loopback0_prefix_len}}.\n• Ensure router {{router4_name}} uses the {{router2_link1_iface}} link on router {{router2_name}} to reach network {{loopback1_network}}/{{loopback1_prefix_len}}.\n• Ensure network {{loopback2_network}}/{{loopback2_prefix_len}} is unreachable for router {{router3_name}}. It has to be reachable for {{router1_name}} and {{router4_name}}.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{loopback0_ip}} {{loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{loopback1_ip}} {{loopback1_mask}}",
            "interface Loopback2",
            "  ip address {{loopback2_ip}} {{loopback2_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface {{router4_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router rip",
            "  version 2",
            "  network 0.0.0.0",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router rip",
            "  version 2",
            "  offset-list 4 out 14",
            "  offset-list 1 out 6 {{router2_link1_iface}}",
            "  network 0.0.0.0",
            "  no auto-summary",
            "access-list 1 permit {{loopback0_network}} {{loopback0_wildcard}}",
            "access-list 4 permit {{loopback2_network}} {{loopback2_wildcard}}"
        ],
        "{{router3_name}}": [
            "router rip",
            "  version 2",
            "  network 0.0.0.0",
            "  no auto-summary"
        ],
        "{{router4_name}}": [
            "router rip",
            "  version 2",
            "  offset-list 2 in 5 {{router4_link3_iface}}",
            "  network 0.0.0.0",
            "  no auto-summary",
            "access-list 2 permit {{loopback1_network}} {{loopback1_wildcard}}"
        ]
    },
    "testcases": [
        {
            "goal": "Configure RIP version 2 on all routers and make sure you have full connectivity. Advertise all loopback interfaces on router {{router2_name}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{link1_network}}/{{link1_prefix_len}}",
                            "{{link3_network}}/{{link3_prefix_len}}",
                            "{{loopback0_network}}/{{loopback0_prefix_len}}",
                            "{{loopback1_network}}/{{loopback1_prefix_len}}",
                            "{{loopback2_network}}/{{loopback2_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{link2_network}}/{{link2_prefix_len}}",
                            "{{link4_network}}/{{link4_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router4_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{link3_network}}/{{link3_prefix_len}}",
                            "{{link4_network}}/{{link4_prefix_len}}"
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router1_name}}",
                    "command": "show ip protocols | section rip",
                    "expected_result": {
                        "networks": [
                            "{{link1_network}}/{{link1_prefix_len}}",
                            "{{link2_network}}/{{link2_prefix_len}}"
                        ]
                    }
                }
            ]
        },
        {
            "goal": "You are only allowed to use offset-lists for this lab.",
            "testcase": []
        },
        {
            "goal": "Ensure router {{router1_name}}, {{router4_name}} and {{router3_name}} use the {{router2_link3_iface}} link on router {{router2_name}} to reach network {{loopback0_network}}/{{loopback0_prefix_len}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show ip route {{loopback0_network}} {{loopback0_mask}}",
                    "expected_result": [
                        {
                            "nexthop_if": {"op": "==", "value": "{{router1_link2_iface}}"}
                        }
                    ],
                    "mode": "strict"
                },
                {
                    "id": "2-2",
                    "node": "{{router4_name}}",
                    "command": "show ip route {{loopback0_network}} {{loopback0_mask}}",
                    "expected_result": [
                        {
                            "nexthop_if": {"op": "==", "value": "{{router4_link3_iface}}"}
                        }
                    ],
                    "mode": "strict"
                },
                {
                    "id": "2-3",
                    "node": "{{router3_name}}",
                    "command": "show ip route {{loopback0_network}} {{loopback0_mask}}",
                    "expected_result": [
                        {
                            "nexthop_if": {"op": "==", "value": "{{router3_link4_iface}}"}
                        }
                    ],
                    "mode": "strict"
                }
            ]
        },
        {
            "goal": "Ensure router {{router4_name}} uses the {{router2_link1_iface}} link on router {{router2_name}} to reach network {{loopback1_network}}/{{loopback1_prefix_len}}.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router4_name}}",
                    "command": "show ip route {{loopback1_network}} {{loopback1_mask}}",
                    "expected_result": [
                        {
                            "nexthop_if": {"op": "==", "value": "{{router4_link4_iface}}"}
                        }
                    ],
                    "mode": "strict"
                }
            ]
        },
        {
            "goal": "Ensure network {{loopback2_network}}/{{loopback2_prefix_len}} is unreachable for router {{router3_name}}. It has to be reachable for {{router1_name}} and {{router4_name}}.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router3_name}}",
                    "command": "show ip route {{loopback2_network}} {{loopback2_mask}}",
                    "expected_result": {"op": "empty"}
                },
                {
                    "id": "4-2",
                    "node": "{{router1_name}}",
                    "command": "show ip route {{loopback2_network}} {{loopback2_mask}}",
                    "expected_result": {
                        "protocol": {"op": "==", "value": "rip"}
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router4_name}}",
                    "command": "show ip route {{loopback2_network}} {{loopback2_mask}}",
                    "expected_result": {
                        "protocol": {"op": "==", "value": "rip"}
                    }
                }
            ]
        }
    ],
