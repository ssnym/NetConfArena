    "scenario": "OSPF NSSA LSA Type 7 to 5 Translator Election",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router4_name}}'s {{router4_link1_iface}}\n        {{router2_name}}'s {{router2_link2_iface}}\n    Area 1:\n        {{router2_name}}'s {{router2_link3_iface}}\n        {{router4_name}}'s {{router4_link4_iface}}\n        {{router3_name}}'s {{router3_link4_iface}}\n        {{router3_name}}'s {{router3_link3_iface}}\n• Configure OSPF Area 1 as NSSA.\n• Redistribute the Loopback0 interface on router {{router3_name}} into OSPF.\n• Ensure router {{router4_name}} is the router performing the translation from LSA Type 7 to Type 5 into Area 0.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback_ip}} {{router3_loopback_mask}}",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown",
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface {{router4_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router4_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 0"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 nssa",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "  network {{link3_network}} {{link3_wildcard}} area 1"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 nssa",
            "  redistribute connected subnets",
            "  network {{link4_network}} {{link4_wildcard}} area 1",
            "  network {{link3_network}} {{link3_wildcard}} area 1"
        ],
        "{{router4_name}}": [
            "router ospf 1",
            "  router-id {{router4_ospf_router_id}}",
            "  log-adjacency-changes",
            "  area 1 nssa",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link4_network}} {{link4_wildcard}} area 1"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router4_name}}'s {{router4_link1_iface}}\n        {{router2_name}}'s {{router2_link2_iface}}\n    Area 1:\n        {{router2_name}}'s {{router2_link3_iface}}\n        {{router4_name}}'s {{router4_link4_iface}}\n        {{router3_name}}'s {{router3_link4_iface}}\n        {{router3_name}}'s {{router3_link3_iface}}",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router1_link1_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router1_link2_iface}}",
                                "area": "0"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router4_link1_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router4_link4_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router2_link2_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router2_link3_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router3_link4_iface}}",
                                "area": "1"
                            },
                            {
                                "interface": "{{router3_link3_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure OSPF Area 1 as NSSA.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router4_name}}",
                    "command": "show ip ospf | begin Area",
                    "expected_result": {
                        "area_id": "1",
                        "type": "nssa"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf | begin Area",
                    "expected_result": {
                        "area_id": "1",
                        "type": "nssa"
                    }
                },
                {
                    "id": "2-3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf | begin Area",
                    "expected_result": {
                        "area_id": "1",
                        "type": "nssa"
                    }
                }
            ]
        },
        {
            "goal": "Redistribute the Loopback0 interface on router {{router3_name}} into OSPF.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {
                        "redistribute": {
                            "op": "contains_all",
                            "value": [
                                "connected, includes subnets in redistribution"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Ensure router {{router4_name}} is the router performing the translation from LSA Type 7 to Type 5 into Area 0.",
            "testcase": [
                {
                    "id": "5",
                    "node": "{{router4_name}}",
                    "command": "show ip ospf | begin Area",
                    "expected_result": {
                        "area_id": "1",
                        "type": "nssa",
                        "nssa_translation": true
                    }
                }
            ]
        }
    ],
