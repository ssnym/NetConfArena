                "label": {
                    "text": "{{router2_name}}",
                    "x": 19.5,
                    "y": -25.0
                },
                "x": -96.6396103068,
                "y": -127.358910397
            }
        },
        "notes": [
            {
                "text": "{{link1_network}}/{{link1_prefix_len}}",
                "x": -285.671139599,
                "y": -129.379725677
            },
            {
                "text": "{{link1_ip1}}",
                "x": -336.582827845,
                "y": -126.752308679
            },
            {
                "text": "{{link1_ip2}}",
                "x": -120.915259583,
                "y": -128.367532368
            }
        ]
    }
}
