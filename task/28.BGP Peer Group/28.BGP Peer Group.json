            "  ip address {{router4_loopback_ip}} {{router4_loopback_mask}}",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{bgp_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  redistribute connected",
            "  neighbor {{peer_group_name}} peer-group",
            "  neighbor {{peer_group_name}} remote-as {{bgp_as}}",
            "  neighbor {{peer_group_name}} route-reflector-client",
