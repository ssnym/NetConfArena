    "testcases": [
        {
            "goal": "Configure peer group {{peer_group_name}} on {{router1_name}} with all three spoke neighbors in AS {{bgp_as}}.",
            "testcase": [
                {
                    "id": "1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip2}}",
                                "remote_as": "{{bgp_as}}",
                                "bgp_state": "Established",
                                "peer_group": "{{peer_group_name}}"
                            },
                            {
                                "neighbor": "{{link2_ip2}}",
                                "remote_as": "{{bgp_as}}",
                                "bgp_state": "Established",
                                "peer_group": "{{peer_group_name}}"
                            },
                            {
                                "neighbor": "{{link3_ip2}}",
                                "remote_as": "{{bgp_as}}",
                                "bgp_state": "Established",
                                "peer_group": "{{peer_group_name}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Router {{router2_name}}, {{router3_name}} and {{router4_name}} should only form IBGP peerings with router {{router1_name}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "all_match",
                        "value": {
                            "neighbor": "{{link1_ip1}}",
                            "remote_as": "{{bgp_as}}",
                            "bgp_state": "Established"
                        }
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "all_match",
                        "value": {
                            "neighbor": "{{link2_ip1}}",
