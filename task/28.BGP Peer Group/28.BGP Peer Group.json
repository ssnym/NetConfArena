        "_loopback4": {
            "type": "random_subnet",
            "pool": "r4_loopback_pool",
            "prefix_len": "r4_loopback_prefix_lens",
            "default": "4.4.4.0/24"
        },
        "router4_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "host",
            "index": 4
        },
        "router4_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "network"
        },
        "router4_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "netmask"
        },
        "router4_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "prefixlen"
        },
        "router4_loopback_cidr": {
            "type": "format",
            "template": "{router4_loopback_network}/{router4_loopback_prefix_len}"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.13.0/24",
            "no_overlap": [
                "_link1"
