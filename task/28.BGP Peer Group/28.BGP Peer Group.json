        "link3_ip2": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 2
        },
        "link3_media": {
            "type": "choice",
            "options": "link3_media_options"
        }
    },
    "scenario": "BGP Peer Group",
    "goals": "\u2022 Configure a peer group called {{peer_group_name}} on router {{router1_name}}. The peer group must include all three IBGP neighbors ({{router2_name}}, {{router3_name}}, {{router4_name}}) in AS {{bgp_as}}, and configure them as route-reflector clients so that routes can be reflected between the spokes.\n\u2022 Router {{router2_name}}, {{router3_name}} and {{router4_name}} should only form IBGP peerings with router {{router1_name}}.\n\u2022 Advertise each router's directly-connected interfaces and Loopback0 into BGP, so that every router in AS {{bgp_as}} sees all internal networks.",
    "topology_model": {
        "nodes": [
            {
                "id": "r1"
            },
            {
                "id": "r2"
            },
            {
                "id": "r3"
            },
            {
                "id": "r4"
            }
        ],
        "links": [
            {
                "id": "link1",
                "nodes": [
                    "r1",
                    "r2"
                ],
                "media": "{{link1_media}}"
            },
            {
                "id": "link2",
                "nodes": [
                    "r1",
                    "r3"
                ],
                "media": "{{link2_media}}"
            },
            {
                "id": "link3",
                "nodes": [
                    "r1",
                    "r4"
                ],
                "media": "{{link3_media}}"
            }
        ]
    },
