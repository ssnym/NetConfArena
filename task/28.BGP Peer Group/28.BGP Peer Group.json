            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "network"
        },
        "link3_mask": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "netmask"
        },
        "link3_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link3",
