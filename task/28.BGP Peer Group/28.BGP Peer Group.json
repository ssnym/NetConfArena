                            "bgp_state": "Established"
                        }
                    }
                }
            ]
        },
        {
            "goal": "Advertise each router's directly-connected interfaces and Loopback0 into BGP, so that every router in AS {{bgp_as}} sees all internal networks.",
            "testcase": [
