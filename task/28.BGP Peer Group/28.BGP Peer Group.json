{
    "params": {
        "bgp_as": {
            "type": "choice",
            "options": "bgp_as_options",
            "default": "1234"
        },
        "peer_group_name": {
            "type": "choice",
            "options": "peer_group_names",
            "default": "PEERS"
        },
        "router1_name": {
            "type": "choice",
            "options": "r1_names",
            "default": "Bit"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "default": "Byte",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "default": "Octet",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names",
            "default": "Nibble",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name"
            ]
        },
        "_loopback1": {
            "type": "random_subnet",
            "pool": "r1_loopback_pool",
            "prefix_len": "r1_loopback_prefix_lens",
            "default": "1.1.1.0/24"
        },
        "router1_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "host",
            "index": 1
        },
        "router1_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "network"
        },
        "router1_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "netmask"
        },
        "router1_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "prefixlen"
        },
        "router1_loopback_cidr": {
            "type": "format",
            "template": "{router1_loopback_network}/{router1_loopback_prefix_len}"
        },
        "_loopback2": {
            "type": "random_subnet",
            "pool": "r2_loopback_pool",
            "prefix_len": "r2_loopback_prefix_lens",
            "default": "2.2.2.0/24"
        },
        "router2_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "host",
            "index": 2
        },
        "router2_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "network"
        },
        "router2_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "netmask"
        },
        "router2_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "prefixlen"
        },
        "router2_loopback_cidr": {
            "type": "format",
            "template": "{router2_loopback_network}/{router2_loopback_prefix_len}"
        },
        "_loopback3": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": "r3_loopback_prefix_lens",
            "default": "3.3.3.0/24"
        },
        "router3_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "host",
            "index": 3
        },
        "router3_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "network"
        },
        "router3_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
