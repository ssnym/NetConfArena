            "interface {{router2_link1_iface}}",
            "  ip vrf forwarding {{vrf_name}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "ip route vrf {{vrf_name}} {{router1_loopback1_network}} {{router1_loopback1_mask}} {{link1_ip1}}",
            "router bgp {{as_number}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router4_loopback0_ip}} remote-as {{as_number}}",
            "  neighbor {{router4_loopback0_ip}} update-source Loopback0",
            "  no auto-summary",
            "  address-family vpnv4",
            "    neighbor {{router4_loopback0_ip}} activate",
            "    neighbor {{router4_loopback0_ip}} send-community extended",
            "  exit-address-family",
            "  address-family ipv4 vrf {{vrf_name}}",
            "    redistribute static",
            "    no synchronization",
            "  exit-address-family"
        ],
        "{{router4_name}}": [
            "ip vrf {{vrf_name}}",
            "  rd {{rd}}",
            "  route-target export {{rt}}",
            "  route-target import {{rt}}",
            "interface {{router4_link4_iface}}",
            "  ip vrf forwarding {{vrf_name}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown",
            "ip route vrf {{vrf_name}} {{router5_loopback1_network}} {{router5_loopback1_mask}} {{link4_ip2}}",
            "router bgp {{as_number}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router2_loopback0_ip}} remote-as {{as_number}}",
            "  neighbor {{router2_loopback0_ip}} update-source Loopback0",
            "  no auto-summary",
            "  address-family vpnv4",
            "    neighbor {{router2_loopback0_ip}} activate",
            "    neighbor {{router2_loopback0_ip}} send-community extended",
            "  exit-address-family",
            "  address-family ipv4 vrf {{vrf_name}}",
            "    redistribute static",
            "    no synchronization",
            "  exit-address-family"
        ]
    },
    "testcases": [
        {
            "goal": "Create the VPN routing instance {{vrf_name}} on {{router2_name}} and {{router4_name}} with route distinguisher {{rd}}, and with {{rt}} as both the exported and the imported route target.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include ^ rd",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "rd {{rd}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "route-target export {{rt}}"
                            },
                            {
                                "line": "route-target import {{rt}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include ^ rd",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "rd {{rd}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "route-target export {{rt}}"
                            },
                            {
                                "line": "route-target import {{rt}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Move the CE-facing interface of each PE into {{vrf_name}} while keeping its current address.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show ip vrf interfaces",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router2_link1_iface}}",
                                "ip_address": "{{link1_ip2}}",
                                "vrf": "{{vrf_name}}",
                                "proto_state": "up"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router4_name}}",
                    "command": "show ip vrf interfaces",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router4_link4_iface}}",
                                "ip_address": "{{link4_ip1}}",
                                "vrf": "{{vrf_name}}",
                                "proto_state": "up"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Build one iBGP VPNv4 session between the two PE Loopback0 addresses in AS {{as_number}}, sourced from Loopback0, and make sure extended communities are exchanged on it.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{router4_loopback0_ip}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{router2_loopback0_ip}}",
                                "remote_ip": "{{router4_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include send-community",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "neighbor {{router4_loopback0_ip}} send-community extended"
                            }
                        ]
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include send-community",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "neighbor {{router2_loopback0_ip}} send-community extended"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Inside {{vrf_name}} reach each customer network with a static route towards the local CE and advertise those routes into the VPN.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "rd": "{{rd}}",
                                "prefix": "{{router1_loopback1_cidr}}"
                            },
                            {
                                "rd": "{{rd}}",
                                "prefix": "{{router5_loopback1_cidr}}",
                                "next_hop": "{{router4_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "rd": "{{rd}}",
                                "prefix": "{{router5_loopback1_cidr}}"
                            },
                            {
                                "rd": "{{rd}}",
                                "prefix": "{{router1_loopback1_cidr}}",
                                "next_hop": "{{router2_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router2_name}}",
                    "command": "show ip route vrf {{vrf_name}} {{router5_loopback1_network}} {{router5_loopback1_mask}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router5_loopback1_cidr}}",
                                "protocol": "bgp",
                                "nexthop_ip": "{{router4_loopback0_ip}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Result: {{router1_name}} must reach {{router5_loopback1_cidr}} and {{router5_name}} must reach {{router1_loopback1_cidr}}. The customer prefixes must stay out of the global routing table of the PEs.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router1_name}}",
                    "command": "ping {{router5_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "5-2",
                    "node": "{{router5_name}}",
                    "command": "ping {{router1_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "5-3",
                    "node": "{{router2_name}}",
                    "command": "show ip route {{router5_loopback1_network}} {{router5_loopback1_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "5-4",
                    "node": "{{router3_name}}",
                    "command": "show ip route {{router1_loopback1_network}} {{router1_loopback1_mask}}",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
