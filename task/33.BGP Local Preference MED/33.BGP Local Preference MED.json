    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp 100",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask 255.255.255.0",
            "  neighbor {{router4_loopback0_ip}} remote-as 100",
            "  neighbor {{router4_loopback0_ip}} update-source Loopback0",
            "  neighbor {{router4_loopback0_ip}} next-hop-self",
            "  neighbor {{router2_loopback0_ip}} remote-as 100",
            "  neighbor {{router2_loopback0_ip}} update-source Loopback0",
            "  neighbor {{router2_loopback0_ip}} next-hop-self",
            "  neighbor {{link3_ip2}} remote-as 200",
            "  neighbor {{link3_ip2}} route-map LOCALPREF in",
            "  neighbor {{link3_ip2}} route-map MED out",
            "  no auto-summary",
            "route-map MED permit 10",
            "  set metric 50",
            "route-map LOCALPREF permit 10",
            "  set local-preference 444"
        ],
        "{{router2_name}}": [
