      "    neighbor {{link2_ip2}} remote-as {{as_b}}",
      "    neighbor {{link2_ip2}} activate",
      "    no synchronization",
      "  exit-address-family"
    ],
    "{{router3_name}}": [
      "ip vrf {{vrf_name}}",
      "  rd {{rd_b}}",
      "  route-target export {{rt_b}}",
      "  route-target import {{rt_b}}",
      "interface {{router3_link2_iface}}",
      "  ip vrf forwarding {{vrf_name}}",
      "  ip address {{link2_ip2}} {{link2_mask}}",
      "  no shutdown",
      "router bgp {{as_b}}",
      "  address-family ipv4 vrf {{vrf_name}}",
      "    neighbor {{link2_ip1}} remote-as {{as_a}}",
      "    neighbor {{link2_ip1}} activate",
      "    no synchronization",
      "  exit-address-family"
    ]
  },
  "testcases": [
    {
      "goal": "On each ASBR create the VPN routing instance {{vrf_name}} and put the inter-AS interface into it, keeping the current addresses.",
      "testcase": [
        {
          "id": "1-1",
          "node": "{{router2_name}}",
          "command": "show ip vrf interfaces",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "interface": "{{router2_link2_iface}}",
                "ip_address": "{{link2_ip1}}",
                "vrf": "{{vrf_name}}",
                "proto_state": "up"
              }
            ]
          }
        },
        {
          "id": "1-2",
          "node": "{{router3_name}}",
          "command": "show ip vrf interfaces",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "interface": "{{router3_link2_iface}}",
                "ip_address": "{{link2_ip2}}",
                "vrf": "{{vrf_name}}",
                "proto_state": "up"
              }
            ]
          }
        },
        {
          "id": "1-3",
          "node": "{{router2_name}}",
          "command": "show running-config | include ^ rd",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "rd {{rd_a}}"
              }
            ]
          }
        },
        {
          "id": "1-4",
          "node": "{{router3_name}}",
          "command": "show running-config | include ^ rd",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "rd {{rd_b}}"
              }
            ]
          }
        }
      ]
    },
    {
      "goal": "The two ASBRs must exchange the customer routes as ordinary IPv4 routes inside that instance, over an eBGP session between {{link2_ip1}} and {{link2_ip2}}.",
      "testcase": [
        {
          "id": "2-1",
          "node": "{{router2_name}}",
          "command": "show ip bgp vpnv4 vrf {{vrf_name}} neighbors {{link2_ip2}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "neighbor": "{{link2_ip2}}",
                "bgp_state": "Established",
                "remote_as": "{{as_b}}"
              }
            ]
          }
        },
        {
          "id": "2-2",
          "node": "{{router3_name}}",
          "command": "show ip bgp vpnv4 vrf {{vrf_name}} neighbors {{link2_ip1}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "neighbor": "{{link2_ip1}}",
                "bgp_state": "Established",
                "remote_as": "{{as_a}}"
              }
            ]
          }
        }
      ]
    },
    {
      "goal": "The inter-AS link must carry no VPNv4 routes and no labels: the two ASBRs must not become VPNv4 peers of each other.",
      "testcase": [
        {
          "id": "3-1",
          "node": "{{router2_name}}",
          "command": "show running-config | include route-target filter",
          "expected_result": {
            "op": "empty"
          }
        },
        {
          "id": "3-2",
          "node": "{{router2_name}}",
          "command": "show running-config | include neighbor {{link2_ip2}} send-community",
          "expected_result": {
            "op": "empty"
          }
        },
        {
          "id": "3-3",
          "node": "{{router3_name}}",
          "command": "show running-config | include neighbor {{link2_ip1}} send-community",
          "expected_result": {
            "op": "empty"
          }
        }
      ]
    },
    {
      "goal": "Result: {{router1_name}} must reach {{router4_loopback1_cidr}} and {{router4_name}} must reach {{router1_loopback1_cidr}} inside {{vrf_name}}, and each ASBR must show the remote customer prefix in the {{vrf_name}} routing table.",
      "testcase": [
        {
          "id": "4-1",
          "node": "{{router2_name}}",
          "command": "show ip route vrf {{vrf_name}} {{router4_loopback1_network}} {{router4_loopback1_mask}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "network": "{{router4_loopback1_cidr}}",
                "protocol": "bgp",
                "nexthop_ip": "{{link2_ip2}}"
              }
            ]
          }
        },
        {
          "id": "4-2",
          "node": "{{router3_name}}",
          "command": "show ip route vrf {{vrf_name}} {{router1_loopback1_network}} {{router1_loopback1_mask}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "network": "{{router1_loopback1_cidr}}",
                "protocol": "bgp",
                "nexthop_ip": "{{link2_ip1}}"
              }
            ]
          }
        },
        {
          "id": "4-3",
          "node": "{{router1_name}}",
          "command": "ping vrf {{vrf_name}} {{router4_loopback1_ip}} source Loopback1",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        },
        {
          "id": "4-4",
          "node": "{{router4_name}}",
          "command": "ping vrf {{vrf_name}} {{router1_loopback1_ip}} source Loopback1",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
