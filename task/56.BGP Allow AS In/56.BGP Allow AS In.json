    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{router1_loopback0_network}} {{router1_loopback0_wildcard}} area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback1_network}} mask {{router1_loopback1_mask}}",
            "  neighbor {{router4_loopback0_ip}} remote-as {{as1}}",
            "  neighbor {{router4_loopback0_ip}} update-source Loopback0",
            "  neighbor {{router3_loopback0_ip}} remote-as {{as1}}",
            "  neighbor {{router3_loopback0_ip}} update-source Loopback0",
            "  neighbor {{link2_ip2}} remote-as {{as2}}",
            "  neighbor {{link2_ip2}} allowas-in",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{link3_network}} mask {{link3_mask}}",
            "  network {{link2_network}} mask {{link2_mask}}",
            "  neighbor {{link3_ip2}} remote-as {{as1}}",
            "  neighbor {{link2_ip1}} remote-as {{as1}}",
            "  neighbor {{link2_ip1}} route-map WEIGHT in",
            "  no auto-summary",
            "access-list 1 permit {{router1_loopback1_network}} {{router1_loopback1_wildcard}}",
            "route-map WEIGHT permit 10",
            "  match ip address 1",
            "  set weight 5000",
            "route-map WEIGHT permit 20"
