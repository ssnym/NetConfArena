  "startup_configs": {
    "{{router2_name}}": [
      "interface Loopback0",
      "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
      "interface {{router2_link1_iface}}",
      "  ip address {{link1_ip2}} {{link1_mask}}",
      "  no shutdown",
      "interface {{router2_link2_iface}}",
      "  ip address {{link2_ip1}} {{link2_mask}}",
      "  no shutdown"
    ],
    "{{router1_name}}": [
      "interface Loopback0",
      "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
      "interface Loopback1",
      "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
      "  ip ospf network point-to-point",
      "interface {{router1_link1_iface}}",
      "  ip address {{link1_ip1}} {{link1_mask}}",
      "  no shutdown",
      "ip route 0.0.0.0 0.0.0.0 {{link1_ip2}}"
    ],
    "{{router3_name}}": [
      "interface Loopback0",
      "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
      "interface Loopback1",
      "  ip address {{router3_loopback1_ip}} {{router3_loopback1_mask}}",
      "  ip ospf network point-to-point",
      "interface {{router3_link2_iface}}",
      "  ip address {{link2_ip2}} {{link2_mask}}",
      "  no shutdown",
      "ip route 0.0.0.0 0.0.0.0 {{link2_ip1}}"
    ]
  },
  "groundtruth_configs": {
    "{{router1_name}}": [
      "interface Tunnel{{tunnel_id}}",
      "  ip address {{tunnel_ip1}} {{tunnel_mask}}",
      "  tunnel source {{router1_link1_iface}}",
      "  tunnel destination {{link2_ip2}}",
      "router ospf 1",
      "  router-id {{router1_loopback0_ip}}",
      "  network {{tunnel_network}} {{tunnel_wildcard}} area 0",
      "  network {{router1_loopback1_network}} {{router1_loopback1_wildcard}} area 0"
    ],
    "{{router3_name}}": [
      "interface Tunnel{{tunnel_id}}",
      "  ip address {{tunnel_ip2}} {{tunnel_mask}}",
      "  tunnel source {{router3_link2_iface}}",
      "  tunnel destination {{link1_ip1}}",
      "router ospf 1",
      "  router-id {{router3_loopback0_ip}}",
      "  network {{tunnel_network}} {{tunnel_wildcard}} area 0",
      "  network {{router3_loopback1_network}} {{router3_loopback1_wildcard}} area 0"
    ]
  },
  "testcases": [
    {
      "goal": "Build a GRE tunnel Tunnel{{tunnel_id}} directly between {{router1_name}} and {{router3_name}} across the transit, addressed out of {{tunnel_cidr}}.",
      "testcase": [
        {
          "id": "1-1",
          "node": "{{router1_name}}",
          "command": "show running-config | include tunnel source|tunnel destination",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "tunnel source {{router1_link1_iface}}"
              },
              {
                "line": "tunnel destination {{link2_ip2}}"
              }
            ]
          }
        },
        {
          "id": "1-2",
          "node": "{{router3_name}}",
          "command": "show running-config | include tunnel source|tunnel destination",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "line": "tunnel source {{router3_link2_iface}}"
              },
              {
                "line": "tunnel destination {{link1_ip1}}"
              }
            ]
          }
        },
        {
          "id": "1-3",
          "node": "{{router1_name}}",
          "command": "ping {{tunnel_ip2}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "goal": "Run OSPF process 1 area 0 over the tunnel only, and advertise the tunnel subnet and the local private network into it.",
      "testcase": [
        {
          "id": "2-1",
          "node": "{{router1_name}}",
          "command": "show ip ospf neighbor",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "neighbor_id": "{{router3_loopback0_ip}}",
                "ip_address": "{{tunnel_ip2}}",
                "interface": "Tunnel{{tunnel_id}}",
                "state": {
                  "op": "regex",
                  "value": "FULL"
                }
              }
            ]
          }
        },
        {
          "id": "2-2",
          "node": "{{router3_name}}",
          "command": "show ip ospf neighbor",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "neighbor_id": "{{router1_loopback0_ip}}",
                "ip_address": "{{tunnel_ip1}}",
                "interface": "Tunnel{{tunnel_id}}",
                "state": {
                  "op": "regex",
                  "value": "FULL"
                }
              }
            ]
          }
        },
        {
          "id": "2-3",
          "node": "{{router1_name}}",
          "command": "show ip ospf neighbor",
          "expected_result": {
            "op": "all_match",
            "value": {
              "interface": "Tunnel{{tunnel_id}}"
            }
          }
        }
      ]
    },
    {
      "goal": "Do not configure anything on {{router2_name}}: it must still have no route to either private network.",
      "testcase": [
        {
          "id": "3-1",
          "node": "{{router2_name}}",
          "command": "show ip route {{router1_loopback1_network}} {{router1_loopback1_mask}}",
          "expected_result": {
            "op": "empty"
          }
        },
        {
          "id": "3-2",
          "node": "{{router2_name}}",
          "command": "show ip route {{router3_loopback1_network}} {{router3_loopback1_mask}}",
          "expected_result": {
            "op": "empty"
          }
        },
        {
          "id": "3-3",
          "node": "{{router2_name}}",
          "command": "show running-config | include router ospf",
          "expected_result": {
            "op": "empty"
          }
        }
      ]
    },
    {
      "goal": "Each site must reach the remote private network with the remote tunnel address as next hop, and {{router1_loopback1_ip}} must be able to ping {{router3_loopback1_ip}}.",
      "testcase": [
        {
          "id": "4-1",
          "node": "{{router1_name}}",
          "command": "show ip route {{router3_loopback1_network}} {{router3_loopback1_mask}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "network": "{{router3_loopback1_cidr}}",
                "protocol": "ospf",
                "nexthop_ip": "{{tunnel_ip2}}"
              }
            ]
          }
        },
        {
          "id": "4-2",
          "node": "{{router3_name}}",
          "command": "show ip route {{router1_loopback1_network}} {{router1_loopback1_mask}}",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "network": "{{router1_loopback1_cidr}}",
                "protocol": "ospf",
                "nexthop_ip": "{{tunnel_ip1}}"
              }
            ]
          }
        },
        {
          "id": "4-3",
          "node": "{{router1_name}}",
          "command": "ping {{router3_loopback1_ip}} source Loopback1",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        },
        {
          "id": "4-4",
          "node": "{{router3_name}}",
          "command": "ping {{router1_loopback1_ip}} source Loopback1",
          "expected_result": {
            "op": "contains_all",
            "value": [
              {
                "success_pct": {
                  "op": ">=",
                  "value": "80"
                }
              }
            ]
          }
        }
      ]
    }
  ]
