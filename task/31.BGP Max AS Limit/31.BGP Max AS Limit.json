    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
            "interface {{router3_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback0_ip}} {{router4_loopback0_mask}}",
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp 2",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  neighbor {{link2_ip2}} remote-as 1",
            "  neighbor {{link1_ip2}} remote-as 3",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp 4",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router2_loopback0_network}} mask {{router2_loopback0_mask}}",
            "  neighbor {{link3_ip2}} remote-as 3",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router bgp 3",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  bgp maxas-limit 1",
            "  network {{router3_loopback0_network}} mask {{router3_loopback0_mask}}",
            "  neighbor {{link1_ip1}} remote-as 2",
            "  neighbor {{link3_ip1}} remote-as 4",
            "  no auto-summary"
        ],
        "{{router4_name}}": [
            "router bgp 1",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router4_loopback0_network}} mask {{router4_loopback0_mask}}",
            "  neighbor {{link2_ip1}} remote-as 2",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between AS 1 – 2, AS 2 – 3 and AS 3 – 4.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip1}}",
                        "remote_as": "2",
                        "bgp_state": "Established"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip2}}",
                        "remote_as": "3"
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link3_ip1}}",
                        "remote_as": "4"
                    }
                }
            ]
        },
        {
            "goal": "Advertise the loopback0 interfaces of all routers in BGP.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router4_loopback0_network}}/24",
                        "as_path": "",
                        "origin": "i"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router1_loopback0_network}}/24",
                        "as_path": "",
                        "origin": "i"
                    }
                },
                {
                    "id": "2-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router3_loopback0_network}}/24",
                        "as_path": "",
                        "origin": "i"
                    }
                },
                {
                    "id": "2-4",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "network": "{{router2_loopback0_network}}/24",
                        "as_path": "",
                        "origin": "i"
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router3_name}} so it only allows prefixes from directly connected autonomous systems.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "all_match",
                        "value": [
                            {
                                "network": "{{router3_loopback0_network}}/24",
                                "as_path": "",
                                "origin": "i"
                            },
                            {
                                "network": "{{router1_loopback0_network}}/24",
                                "as_path": "2",
                                "origin": "i"
                            },
                            {
                                "network": "{{router2_loopback0_network}}/24",
                                "as_path": "4",
                                "origin": "i"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "You are not allowed to use as path filtering or any regular expressions.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include as-path|filter-list",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include as-path|filter-list",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include as-path|filter-list",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-4",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include as-path|filter-list",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
