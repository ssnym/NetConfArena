{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name"
            ]
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.23.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.12.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_cidr": {
            "type": "format",
            "template": "{link2_network}/{link2_prefix_len}"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "link3_media": {
            "type": "choice",
            "options": "link3_media_options"
        },
        "_router1_loopback0": {
            "type": "random_subnet",
            "pool": "r1_loopback0_pool",
            "prefix_len": "r1_loopback0_prefix_lens",
            "default": "2.2.2.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "router1_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "network"
        },
        "router1_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "netmask"
        },
        "router1_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "prefixlen"
        },
        "router1_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "wildcard"
        },
        "router1_loopback0_cidr": {
            "type": "format",
            "template": "{router1_loopback0_network}/{router1_loopback0_prefix_len}"
        },
        "router1_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router4_loopback0": {
            "type": "random_subnet",
            "pool": "r4_loopback0_pool",
            "prefix_len": "r4_loopback0_prefix_lens",
            "default": "1.1.1.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_router1_loopback0"
            ]
        },
        "router4_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router4_loopback0",
            "attr": "network"
        },
        "router4_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router4_loopback0",
            "attr": "netmask"
        },
        "router4_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router4_loopback0",
            "attr": "prefixlen"
        },
        "router4_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router4_loopback0",
            "attr": "wildcard"
        },
        "router4_loopback0_cidr": {
            "type": "format",
            "template": "{router4_loopback0_network}/{router4_loopback0_prefix_len}"
        },
        "router4_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router4_loopback0",
            "attr": "host",
            "index": 1
        },
        "_link3": {
            "type": "random_subnet",
            "pool": "link3_pool",
            "prefix_len": "link3_prefix_lens",
            "default": "192.168.34.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "link3_network": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "network"
        },
        "link3_mask": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "netmask"
        },
        "link3_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "prefixlen"
        },
        "link3_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "wildcard"
        },
        "link3_cidr": {
            "type": "format",
            "template": "{link3_network}/{link3_prefix_len}"
        },
        "link3_ip1": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 1
        },
        "link3_ip2": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 2
        },
        "_router2_loopback0": {
            "type": "random_subnet",
            "pool": "r2_loopback0_pool",
            "prefix_len": "r2_loopback0_prefix_lens",
            "default": "4.4.4.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_link3"
            ]
        },
        "router2_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "network"
        },
        "router2_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "netmask"
        },
        "router2_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "prefixlen"
        },
        "router2_loopback0_cidr": {
            "type": "format",
            "template": "{router2_loopback0_network}/{router2_loopback0_prefix_len}"
        },
        "router2_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router3_loopback0": {
            "type": "random_subnet",
            "pool": "r3_loopback0_pool",
            "prefix_len": "r3_loopback0_prefix_lens",
            "default": "3.3.3.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_link3",
                "_router2_loopback0"
            ]
        },
        "router3_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "network"
        },
        "router3_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "netmask"
        },
        "router3_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "prefixlen"
        },
        "router3_loopback0_cidr": {
            "type": "format",
            "template": "{router3_loopback0_network}/{router3_loopback0_prefix_len}"
        },
        "router3_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "host",
            "index": 1
        }
    },
    "scenario": "BGP Max AS Limit",
    "goals": "• Configure EBGP between AS 1 – 2, AS 2 – 3 and AS 3 – 4.\n  AS 1: {{router4_name}}\n  AS 2: {{router1_name}}\n  AS 3: {{router3_name}}\n  AS 4: {{router2_name}}\n• Advertise the loopback0 interfaces of all routers in BGP.\n• Configure router {{router3_name}} so it only allows prefixes from directly connected autonomous systems.\n• You are not allowed to use as path filtering or any regular expressions.",
