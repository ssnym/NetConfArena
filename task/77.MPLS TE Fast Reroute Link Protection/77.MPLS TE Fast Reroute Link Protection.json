    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  router-id {{router1_loopback0_ip}}",
            "  network {{router1_loopback0_ip}} 0.0.0.0 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link3_network}} {{link3_wildcard}} area 0",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback0 force",
            "interface {{router1_link1_iface}}",
            "  mpls ip",
            "interface {{router1_link3_iface}}",
            "  mpls ip",
            "exit",
            "mpls traffic-eng tunnels",
            "interface {{router1_link1_iface}}",
            "  mpls traffic-eng tunnels",
            "  ip rsvp bandwidth 50000",
            "interface {{router1_link3_iface}}",
            "  mpls traffic-eng tunnels",
            "  ip rsvp bandwidth 50000",
            "router ospf 1",
            "  mpls traffic-eng router-id Loopback0",
            "  mpls traffic-eng area 0",
            "ip explicit-path name {{primary_path_name}} enable",
            "  next-address {{link1_ip2}}",
            "  next-address {{link2_ip2}}",
            "interface Tunnel{{primary_tunnel_id}}",
            "  ip unnumbered Loopback0",
            "  tunnel mode mpls traffic-eng",
            "  tunnel destination {{router4_loopback0_ip}}",
            "  tunnel mpls traffic-eng path-option 10 explicit name {{primary_path_name}}",
            "  tunnel mpls traffic-eng autoroute announce"
