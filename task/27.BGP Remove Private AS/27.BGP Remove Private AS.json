    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback_ip}} {{router3_loopback_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback_ip}} {{router4_loopback_mask}}",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{link1_network}}",
            "  neighbor {{link1_ip1}} remote-as {{as1}}",
            "  neighbor {{link1_ip1}} remove-private-as",
            "  neighbor {{link2_ip2}} remote-as {{private_as1}}",
            "  neighbor {{link3_ip2}} remote-as {{private_as2}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router bgp {{private_as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router3_loopback_network}} mask {{router3_loopback_mask}}",
            "  neighbor {{link2_ip1}} remote-as {{as2}}",
            "  no auto-summary"
        ],
        "{{router4_name}}": [
            "router bgp {{private_as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router4_loopback_network}} mask {{router4_loopback_mask}}",
            "  neighbor {{link3_ip1}} remote-as {{as2}}",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between {{router1_name}} (AS {{as1}}) and {{router2_name}} (AS {{as2}}) over their directly connected {{link1_media}} link.",
            "testcase": [
                {
                    "id": "1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip2}}",
                                "remote_as": "{{as2}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router2_name}} (AS {{as2}}) and {{router3_name}} (AS {{private_as1}}) over their directly connected {{link2_media}} link.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip2}}",
                                "remote_as": "{{private_as1}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between {{router2_name}} (AS {{as2}}) and {{router4_name}} (AS {{private_as2}}) over their directly connected {{link3_media}} link.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link3_ip2}}",
                                "remote_as": "{{private_as2}}",
                                "bgp_state": "Established"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Advertise the Loopback0 interfaces on router {{router3_name}} and {{router4_name}}.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router3_loopback_cidr}}",
                                "origin": "i"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router4_loopback_cidr}}",
                                "origin": "i"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Ensure AS {{as1}} does not see the private AS numbers but has connectivity to {{router3_loopback_cidr}} and {{router4_loopback_cidr}}.",
            "testcase": [
                {
                    "id": "5",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router3_loopback_cidr}}",
                                "as_path": {
                                    "op": "==",
                                    "value": "{{as2}}"
                                }
                            },
                            {
                                "network": "{{router4_loopback_cidr}}",
                                "as_path": {
                                    "op": "==",
                                    "value": "{{as2}}"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
