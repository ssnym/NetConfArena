{
    "params": {
        "as1": {
            "type": "choice",
            "options": "as1_options",
            "default": "1"
        },
        "as2": {
            "type": "choice",
            "options": "as2_options",
            "default": "2",
            "different_from": [
                "as1"
            ]
        },
        "private_as1": {
            "type": "choice",
            "options": "private_as1_options",
            "default": "65503"
        },
        "private_as2": {
            "type": "choice",
            "options": "private_as2_options",
            "default": "65504",
            "different_from": [
                "private_as1"
            ]
        },
        "router1_name": {
            "type": "choice",
            "options": "r1_names",
            "default": "Emperor"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "default": "Tsar",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "default": "Kaiser",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names",
            "default": "Caesar",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name"
            ]
        },
        "_loopback3": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": "r3_loopback_prefix_lens",
            "default": "3.3.3.0/24"
        },
        "router3_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "host",
            "index": 3
        },
        "router3_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "network"
        },
        "router3_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "netmask"
        },
        "router3_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "prefixlen"
        },
        "router3_loopback_cidr": {
            "type": "format",
            "template": "{router3_loopback_network}/{router3_loopback_prefix_len}"
        },
        "_loopback4": {
            "type": "random_subnet",
            "pool": "r4_loopback_pool",
            "prefix_len": "r4_loopback_prefix_lens",
            "default": "4.4.4.0/24"
        },
        "router4_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "host",
            "index": 4
        },
        "router4_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "network"
        },
        "router4_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "netmask"
        },
        "router4_loopback_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "prefixlen"
        },
        "router4_loopback_cidr": {
            "type": "format",
            "template": "{router4_loopback_network}/{router4_loopback_prefix_len}"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.23.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link3": {
            "type": "random_subnet",
            "pool": "link3_pool",
            "prefix_len": "link3_prefix_lens",
            "default": "192.168.24.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "link3_network": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "network"
        },
        "link3_mask": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "netmask"
        },
        "link3_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "prefixlen"
        },
        "link3_ip1": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 1
        },
        "link3_ip2": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 2
        },
        "link3_media": {
            "type": "choice",
            "options": "link3_media_options"
        }
    },
    "scenario": "BGP Remove Private AS",
    "goals": "\u2022 Configure EBGP between {{router1_name}} (AS {{as1}}) and {{router2_name}} (AS {{as2}}) over their directly connected {{link1_media}} link.\n\u2022 Configure EBGP between {{router2_name}} (AS {{as2}}) and {{router3_name}} (AS {{private_as1}}) over their directly connected {{link2_media}} link.\n\u2022 Configure EBGP between {{router2_name}} (AS {{as2}}) and {{router4_name}} (AS {{private_as2}}) over their directly connected {{link3_media}} link.\n\u2022 Advertise the Loopback0 interfaces on router {{router3_name}} ({{router3_loopback_cidr}}) and {{router4_name}} ({{router4_loopback_cidr}}).\n\u2022 Configure {{router2_name}} so AS {{as1}} does not see private AS numbers while retaining connectivity to {{router3_loopback_cidr}} and {{router4_loopback_cidr}}.",
    "topology_model": {
        "nodes": [
            {
                "id": "r1"
            },
            {
                "id": "r2"
            },
            {
                "id": "r3"
