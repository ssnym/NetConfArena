    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "router rip",
            "  version 2",
            "  network {{link1_network}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "router rip",
            "  version 2",
            "  network {{link1_network}}",
            "  network {{link2_network}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "router rip",
            "  version 2",
            "  network {{link2_network}}",
            "  no auto-summary"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "interface Tunnel1",
            "  ip address {{router1_tunnel1_ip}} {{router1_tunnel1_mask}}",
            "  tunnel source {{router1_link1_iface}}",
            "  tunnel destination {{link2_ip2}}",
            "router bgp 123",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  neighbor {{link2_ip2}} remote-as 123",
            "  neighbor {{link2_ip2}} route-map CHANGENEXTHOP in",
            "  no auto-summary",
            "route-map CHANGENEXTHOP permit 10",
            "  set ip next-hop {{router3_tunnel1_ip}}"
        ],
        "{{router2_name}}": [],
        "{{router3_name}}": [
            "interface Tunnel1",
            "  ip address {{router3_tunnel1_ip}} {{router3_tunnel1_mask}}",
            "  tunnel source {{router3_link2_iface}}",
            "  tunnel destination {{link1_ip1}}",
            "router bgp 123",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router3_loopback0_network}} mask {{router3_loopback0_mask}}",
            "  neighbor {{link1_ip1}} remote-as 123",
            "  neighbor {{link1_ip1}} route-map CHANGENEXTHOP in",
            "  no auto-summary",
            "route-map CHANGENEXTHOP permit 10",
            "  set ip next-hop {{router1_tunnel1_ip}}"
        ]
    },
    "testcases": [
        {
            "goal": "Configure IBGP AS 123 on router {{router1_name}} and {{router3_name}}, use the physical interfaces.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link2_ip2}}",
                        "remote_as": "123",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link1_ip1}}",
                        "remote_ip": "{{link2_ip2}}"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "neighbor": "{{link1_ip1}}",
                        "remote_as": "123",
                        "bgp_state": "Established",
                        "localhost_ip": "{{link2_ip2}}",
                        "remote_ip": "{{link1_ip1}}"
                    }
                }
            ]
        },
        {
            "goal": "The senior network engineer has prohibited you from making any changes to router {{router2_name}}.",
            "testcase": []
        },
        {
            "goal": "Advertise the loopback0 interfaces from router {{router1_name}} and {{router3_name}} into BGP.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_network}}/24"
                            },
                            {
                                "network": "{{router3_loopback0_network}}/24"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_network}}/24"
                            },
                            {
                                "network": "{{router3_loopback0_network}}/24"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "You are not allowed to use static routes to reach the loopback interfaces, use IBGP to achieve this.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | section ip route",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | section ip route",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "Ensure you can ping each others loopback addresses from router {{router1_name}} or {{router3_name}}.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router1_name}}",
                    "command": "ping {{router3_loopback0_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router3_name}}",
                    "command": "ping {{router1_loopback0_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                }
            ]
        }
    ]
}
