{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.23.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_cidr": {
            "type": "format",
            "template": "{link2_network}/{link2_prefix_len}"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "_router1_loopback0": {
            "type": "random_subnet",
            "pool": "r1_loopback0_pool",
            "prefix_len": "r1_loopback0_prefix_lens",
            "default": "1.1.1.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "router1_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "network"
        },
        "router1_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "netmask"
        },
        "router1_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "prefixlen"
        },
        "router1_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "wildcard"
        },
        "router1_loopback0_cidr": {
            "type": "format",
            "template": "{router1_loopback0_network}/{router1_loopback0_prefix_len}"
        },
        "router1_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router1_tunnel1": {
            "type": "random_subnet",
            "pool": "r1_tunnel1_pool",
            "prefix_len": "r1_tunnel1_prefix_lens",
            "default": "192.168.13.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_router1_loopback0"
            ]
        },
        "router1_tunnel1_network": {
            "type": "subnet_attr",
            "subnet": "_router1_tunnel1",
            "attr": "network"
        },
        "router1_tunnel1_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_tunnel1",
            "attr": "netmask"
        },
        "router1_tunnel1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_tunnel1",
            "attr": "prefixlen"
        },
        "router1_tunnel1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_tunnel1",
            "attr": "wildcard"
        },
        "router1_tunnel1_cidr": {
            "type": "format",
            "template": "{router1_tunnel1_network}/{router1_tunnel1_prefix_len}"
        },
        "router1_tunnel1_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_tunnel1",
            "attr": "host",
            "index": 1
        },
        "_router3_loopback0": {
            "type": "random_subnet",
            "pool": "r3_loopback0_pool",
            "prefix_len": "r3_loopback0_prefix_lens",
            "default": "3.3.3.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_router1_loopback0",
                "_router1_tunnel1"
            ]
        },
        "router3_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "network"
        },
        "router3_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "netmask"
        },
        "router3_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "prefixlen"
        },
        "router3_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "wildcard"
        },
        "router3_loopback0_cidr": {
            "type": "format",
            "template": "{router3_loopback0_network}/{router3_loopback0_prefix_len}"
        },
        "router3_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router3_tunnel1": {
            "type": "random_subnet",
            "pool": "r3_tunnel1_pool",
            "prefix_len": "r3_tunnel1_prefix_lens",
            "default": "192.168.13.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_router1_loopback0",
                "_router1_tunnel1",
                "_router3_loopback0"
            ]
        },
        "router3_tunnel1_network": {
            "type": "same_as",
            "param": "router1_tunnel1_network"
        },
        "router3_tunnel1_mask": {
            "type": "same_as",
            "param": "router1_tunnel1_mask"
        },
        "router3_tunnel1_prefix_len": {
            "type": "same_as",
            "param": "router1_tunnel1_prefix_len"
        },
        "router3_tunnel1_wildcard": {
            "type": "same_as",
            "param": "router1_tunnel1_wildcard"
        },
        "router3_tunnel1_cidr": {
            "type": "same_as",
            "param": "router1_tunnel1_cidr"
        },
        "router3_tunnel1_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_tunnel1",
            "attr": "host",
            "index": 3
        }
    },
    "scenario": "BGP IBGP Blackhole Routing",
    "goals": "• Configure IBGP AS 123 on router {{router1_name}} and {{router3_name}}, use the physical interfaces.\n• The senior network engineer has prohibited you from making any changes to router {{router2_name}}.\n• Advertise the loopback0 interfaces from router {{router1_name}} and {{router3_name}} into BGP.\n• You are not allowed to use static routes to reach the loopback interfaces, use IBGP to achieve this.\n• Ensure you can ping each others loopback addresses from router {{router1_name}} or {{router3_name}}.",
    "topology_model": {
        "nodes": [
            "r1",
            "r2",
            "r3"
        ],
