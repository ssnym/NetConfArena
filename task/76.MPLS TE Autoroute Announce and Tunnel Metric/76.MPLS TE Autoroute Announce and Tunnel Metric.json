    "testcases": [
        {
            "goal": "Make {{router1_name}} install the tunnel as the path for the destinations behind the tunnel tail, so that its routing table reaches {{router4_loopback0_cidr}} through Tunnel{{tunnel_id}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include autoroute announce",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel mpls traffic-eng autoroute announce"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip route",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router4_loopback0_ip}}",
                                "prefix_length": "32",
                                "nexthop_if": "Tunnel{{tunnel_id}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router1_name}}",
                    "command": "show ip route {{router4_loopback0_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router4_loopback0_cidr}}",
                                "protocol": "ospf"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Give the tunnel a fixed cost of {{tunnel_metric}} that does not follow the cost of the underlying physical path, so the tunnel route shows metric {{tunnel_metric}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include autoroute metric",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel mpls traffic-eng autoroute metric absolute {{tunnel_metric}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip route {{router4_loopback0_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router4_loopback0_cidr}}",
                                "metric": {
                                    "op": "==",
                                    "value": "{{tunnel_route_metric}}"
                                }
                            }
                        ]
                    }
                }
            ]
