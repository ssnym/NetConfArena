    "scenario": "OSPF Totally NSSA",
    "goals": "• Configure OSPF on all routers, use the Areas as specified below.\n    Area 0:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router2_name}}'s {{router2_link1_iface}}\n    Area 1:\n        {{router2_name}}'s {{router2_link2_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}\n• Router {{router1_name}}: create additional loopbacks:\n    L0: {{extra_lo1_ip}} /24\n    L1: {{extra_lo2_ip}} /24\n    L2: {{extra_lo3_ip}} /24\n    L3: {{extra_lo4_ip}} /24\n• Redistribute these networks into OSPF. Do not use the “network” command to achieve this.\n• Take a look at the routing table of Router {{router3_name}}, you should see all 4 networks. Make sure you can ping them.\n• Change the area type of Area 1 so you don’t see the 4 networks anymore but only 1 default route.\n• Make sure you can still ping the 4 networks.\n• Router {{router1_name}}: create additional loopbacks:\n    L4: {{extra_lo5_ip}} /24\n    L5: {{extra_lo6_ip}} /24\n    L6: {{extra_lo7_ip}} /24\n    L7: {{extra_lo8_ip}} /24\n• Advertise these 4 networks into OSPF Area 0 by using the network command.\n• Take a look at Router {{router3_name}}, you should see all 4 networks.\n• Change the area type of Area 1 so you don’t see these 4 networks anymore but only a default route.\n• Make sure you can still ping the 4 networks.\n• Router {{router3_name}}: configure RIP version 2 and advertise the {{undertaker_lo_network}} network into RIP. (Loopback0 {{undertaker_lo_ip}} /24 is pre-configured.)\n• Router {{router3_name}}: Redistribute RIP into OSPF, you are not allowed to turn Area 1 back into a standard Area.\n• Make sure you still meet all the previous requirements.\n• Make sure you can ping the {{undertaker_lo_network}} network from Router {{router1_name}}.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{undertaker_lo_ip}} {{undertaker_lo_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{extra_lo1_ip}} {{extra_lo1_mask}}",
            "interface Loopback1",
            "  ip address {{extra_lo2_ip}} {{extra_lo2_mask}}",
            "interface Loopback2",
            "  ip address {{extra_lo3_ip}} {{extra_lo3_mask}}",
            "interface Loopback3",
            "  ip address {{extra_lo4_ip}} {{extra_lo4_mask}}",
            "interface Loopback4",
            "  ip address {{extra_lo5_ip}} {{extra_lo5_mask}}",
            "interface Loopback5",
            "  ip address {{extra_lo6_ip}} {{extra_lo6_mask}}",
            "interface Loopback6",
            "  ip address {{extra_lo7_ip}} {{extra_lo7_mask}}",
            "interface Loopback7",
            "  ip address {{extra_lo8_ip}} {{extra_lo8_mask}}",
            "router ospf 1",
            "  log-adjacency-changes",
            "  redistribute connected subnets",
            "  network {{extra_lo5_network}} 0.0.0.255 area 0",
            "  network {{extra_lo6_network}} 0.0.0.255 area 0",
            "  network {{extra_lo7_network}} 0.0.0.255 area 0",
            "  network {{extra_lo8_network}} 0.0.0.255 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 nssa no-summary",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 1"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 nssa",
            "  redistribute rip subnets",
            "  network {{link2_network}} {{link2_wildcard}} area 1",
            "router rip",
            "  version 2",
            "  network 2.0.0.0"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, use the Areas as specified below.\n    Area 0:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router2_name}}'s {{router2_link1_iface}}\n    Area 1:\n        {{router2_name}}'s {{router2_link2_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": [
                        {
                            "interface": "{{router1_link1_iface}}",
                            "area": "0"
                        }
                    ]
                },
                {
                    "id": "1-2",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": [
                        {
                            "interface": "{{router2_link1_iface}}",
                            "area": "0"
                        },
                        {
                            "interface": "{{router2_link2_iface}}",
                            "area": "1"
                        }
                    ]
                },
                {
                    "id": "1-3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": [
                        {
                            "interface": "{{router3_link2_iface}}",
                            "area": "1"
                        }
                    ]
                }
            ]
        },
        {
            "goal": "Router {{router1_name}}: create additional loopbacks:\n    L0: {{extra_lo1_ip}} /24\n    L1: {{extra_lo2_ip}} /24\n    L2: {{extra_lo3_ip}} /24\n    L3: {{extra_lo4_ip}} /24",
            "testcase": []
        },
        {
            "goal": "Redistribute these networks into OSPF. Do not use the “network” command to achieve this.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router1_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {
                        "redistribute": {
                            "op": "contains_all",
                            "value": [
                                "connected, includes subnets in redistribution"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Take a look at the routing table of Router {{router3_name}}, you should see all 4 networks. Make sure you can ping them.",
            "testcase": []
        },
        {
            "goal": "Change the area type of Area 1 so you don’t see the 4 networks anymore but only 1 default route.",
            "testcase": [
