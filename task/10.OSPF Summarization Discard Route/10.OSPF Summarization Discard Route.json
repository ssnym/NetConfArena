{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names"
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.23.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "no_overlap": [
                "_link1"
            ],
            "default": "192.168.12.0/24"
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_spielburg_lo": {
            "type": "random_subnet",
            "pool": "r2_loopback_pool",
            "prefix_len": 24,
            "default": "3.3.3.0/24"
        },
        "spielburg_lo_ip": {
            "type": "subnet_attr",
            "subnet": "_spielburg_lo",
            "attr": "host",
            "index": 1
        },
        "spielburg_lo_mask": {
            "type": "subnet_attr",
            "subnet": "_spielburg_lo",
            "attr": "netmask"
        },
        "spielburg_lo_network": {
            "type": "subnet_attr",
            "subnet": "_spielburg_lo",
            "attr": "network"
        }
    },
    "scenario": "OSPF Summarization Discard Route",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows.\n    {{router3_name}}: All interfaces are in Area 0\n    {{router1_name}}:\n        {{router1_link1_iface}} is in Area 1\n        {{router1_link2_iface}} is in Area 0\n    {{router2_name}}: All interfaces are in Area 1\n• Configure router {{router1_name}} to summarize network {{spielburg_lo_network}} /24 to 3.0.0.0 /8.\n• Configure router {{router1_name}} so it doesn't add a null0 entry in its routing table.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{spielburg_lo_ip}} {{spielburg_lo_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  no discard-route internal",
            "  area 1 range 3.0.0.0 255.0.0.0",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 1"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{spielburg_lo_network}} 0.0.0.255 area 1",
            "  network {{link1_network}} {{link1_wildcard}} area 1"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{link2_network}} {{link2_wildcard}} area 0"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows.\n    {{router3_name}}: All interfaces are in Area 0\n    {{router1_name}}:\n        {{router1_link1_iface}} is in Area 1\n        {{router1_link2_iface}} is in Area 0\n    {{router2_name}}: All interfaces are in Area 1",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": [
                        {
                            "interface": "{{router3_link2_iface}}",
                            "area": "0"
                        }
                    ]
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": [
                        {
                            "interface": "{{router1_link2_iface}}",
                            "area": "0"
                        },
                        {
                            "interface": "{{router1_link1_iface}}",
                            "area": "1"
                        }
                    ]
                },
                {
                    "id": "1-3",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": [
                        {
                            "interface": "{{router2_link1_iface}}",
                            "area": "1"
                        },
                        {
                            "interface": "Loopback0",
                            "area": "1"
                        }
                    ]
                }
            ]
        },
        {
            "goal": "Configure router {{router1_name}} to summarize network {{spielburg_lo_network}} /24 to 3.0.0.0 /8.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf database summary",
                    "expected_result": {
                        "area": "0",
                        "link_state_id": "3.0.0.0",
                        "network_mask": "/8"
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router1_name}} so it doesn't add a null0 entry in its routing table.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router1_name}}",
                    "command": "show ip route 3.0.0.0 255.0.0.0",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ],
    "topology_model": {
        "nodes": [
            "r1",
            "r2",
            "r3"
        ],
        "links": [
