{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "_loopback1": {
            "type": "random_subnet",
            "pool": "r1_loopback_pool",
            "prefix_len": 24,
            "default": "1.1.1.0/24"
        },
        "router1_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "host",
            "index": 1
        },
        "router1_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "netmask"
        },
        "router1_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback1",
            "attr": "network"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.23.0/24"
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_r3_summary_block": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": 22,
            "default": "172.16.0.0/22"
        },
        "r3_summary_network": {
            "type": "subnet_attr",
            "subnet": "_r3_summary_block",
            "attr": "network"
        },
        "r3_summary_mask": {
            "type": "subnet_attr",
            "subnet": "_r3_summary_block",
            "attr": "netmask"
        },
        "r3_summary_wildcard": {
            "type": "subnet_attr",
            "subnet": "_r3_summary_block",
            "attr": "wildcard"
        },
        "r3_lo0_ip": {
            "type": "subnet_nth",
            "subnet": "_r3_summary_block",
            "new_prefix": 24,
            "n": 0,
            "attr": "host",
            "index": 1
        },
        "r3_lo1_ip": {
            "type": "subnet_nth",
            "subnet": "_r3_summary_block",
            "new_prefix": 24,
            "n": 1,
            "attr": "host",
            "index": 1
        },
        "r3_lo2_ip": {
            "type": "subnet_nth",
            "subnet": "_r3_summary_block",
            "new_prefix": 24,
            "n": 2,
            "attr": "host",
            "index": 1
        },
        "r3_lo3_ip": {
            "type": "subnet_nth",
            "subnet": "_r3_summary_block",
            "new_prefix": 24,
            "n": 3,
            "attr": "host",
            "index": 1
        }
    },
    "scenario": "OSPF Virtual Link and Summarization",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router1_name}}'s Loopback0\n    Area 1:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router2_name}}'s {{router2_link1_iface}}\n    Area 2:\n        {{router2_name}}'s {{router2_link2_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}\n• Area 2 has no direct connection to Area 0. Solve this by using OSPF commands and ensure you have full reachability.\n• Create some extra loopbacks on router {{router3_name}} and advertise them in area 2:\n    Loopback0: {{r3_lo0_ip}} /24\n    Loopback1: {{r3_lo1_ip}} /24\n    Loopback2: {{r3_lo2_ip}} /24\n    Loopback3: {{r3_lo3_ip}} /24\n• Make sure router {{router1_name}} only sees {{r3_summary_network}}/22 in its routing table. You are only allowed to make changes to router {{router2_name}} for the summarization requirement.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback_ip}} {{router1_loopback_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{r3_lo0_ip}} 255.255.255.0",
            "interface Loopback1",
            "  ip address {{r3_lo1_ip}} 255.255.255.0",
            "interface Loopback2",
            "  ip address {{r3_lo2_ip}} 255.255.255.0",
            "interface Loopback3",
            "  ip address {{r3_lo3_ip}} 255.255.255.0",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 virtual-link {{link2_ip1}}",
            "  network {{router1_loopback_network}} 0.0.0.255 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 1"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 virtual-link {{router1_loopback_ip}}",
            "  area 2 range {{r3_summary_network}} {{r3_summary_mask}}",
            "  network {{link1_network}} {{link1_wildcard}} area 1",
            "  network {{link2_network}} {{link2_wildcard}} area 2"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{r3_summary_network}} {{r3_summary_wildcard}} area 2",
            "  network {{link2_network}} {{link2_wildcard}} area 2"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router1_name}}'s Loopback0\n    Area 1:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router2_name}}'s {{router2_link1_iface}}\n    Area 2:\n        {{router2_name}}'s {{router2_link2_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "0"
                            },
                            {
                                "interface": "{{router1_link1_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router2_link1_iface}}",
                                "area": "1"
                            },
                            {
                                "interface": "{{router2_link2_iface}}",
                                "area": "2"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router3_link2_iface}}",
                                "area": "2"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router1_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {},
                    "output": "router_id"
                },
                {
                    "id": "1-5",
                    "node": "{{router2_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {},
                    "output": "router_id"
                }
            ]
        },
        {
            "goal": "Area 2 has no direct connection to Area 0. Solve this by using OSPF commands and ensure you have full reachability.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf virtual-links",
                    "expected_result": {
                        "router_id": "$1-5_{{router2_name}}_router_id$",
                        "state": "up"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf virtual-links",
                    "expected_result": {
                        "router_id": "$1-4_{{router1_name}}_router_id$",
                        "state": "up"
                    }
                }
            ]
        },
        {
            "goal": "Create some extra loopbacks on router {{router3_name}} and advertise them in area 2:\n    Loopback0: {{r3_lo0_ip}} /24\n    Loopback1: {{r3_lo1_ip}} /24\n    Loopback2: {{r3_lo2_ip}} /24\n    Loopback3: {{r3_lo3_ip}} /24",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "2"
                            },
                            {
                                "interface": "Loopback1",
                                "area": "2"
                            },
                            {
                                "interface": "Loopback2",
                                "area": "2"
                            },
                            {
                                "interface": "Loopback3",
                                "area": "2"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Make sure router {{router1_name}} only sees {{r3_summary_network}}/22 in its routing table. You are only allowed to make changes to router {{router2_name}} for the summarization requirement.",
            "testcase": [
                {
                    "id": "4",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf database summary",
                    "expected_result": {
                        "area": "0",
                        "link_state_id": "{{r3_summary_network}}",
                        "network_mask": "/22"
                    }
                }
            ]
        }
    ],
    "topology_model": {
        "nodes": [
            "r1",
            "r2",
            "r3"
