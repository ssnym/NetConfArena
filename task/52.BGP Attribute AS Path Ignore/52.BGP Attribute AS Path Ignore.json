    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  neighbor {{link2_ip2}} remote-as {{as4}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link1_ip1}} remote-as {{as1}}",
            "  neighbor {{link3_ip2}} remote-as {{as3}}",
            "  neighbor {{link3_ip2}} route-map as-prepend out",
            "  no auto-summary",
            "route-map as-prepend permit 10",
            "  set as-path prepend {{as2_prepend_sequence}}"
        ],
        "{{router3_name}}": [
