            "goal": "Advertise the Loopback0 networks of {{router2_name}} and {{router5_name}} into BGP, and ensure {{router2_name}} and {{router5_name}} can ping each other's Loopback0.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "ping {{router5_lo0_ip}} source {{router2_lo0_ip}}",
                    "expected_result": {
                        "success_pct": {
                            "op": ">",
                            "value": "0"
                        }
                    }
                },
                {
