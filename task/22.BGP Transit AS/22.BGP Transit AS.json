    "scenario": "BGP Transit AS",
    "goals": "• Configure EBGP between {{router2_name}} (AS {{as1}}) and {{router6_name}} (AS {{as2}}) using the physical interface addresses on the directly connected link.\n• Configure EBGP between {{router4_name}} (AS {{as2}}) and {{router5_name}} (AS {{as3}}) using the physical interface addresses on the directly connected link.\n• Configure full-mesh IBGP among the four AS {{as2}} routers ({{router6_name}}, {{router1_name}}, {{router3_name}}, {{router4_name}}) using Loopback0 as the update-source. Ensure the four Loopback0 interfaces are mutually reachable within AS {{as2}} so the IBGP sessions can come up.\n• Advertise the Loopback0 networks of {{router2_name}} and {{router5_name}} into BGP, and ensure {{router2_name}} and {{router5_name}} can ping each other's Loopback0.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_lo0_ip}} {{router1_lo0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_lo0_ip}} {{router2_lo0_mask}}",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_lo0_ip}} {{router3_lo0_mask}}",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown",
            "interface {{router3_link5_iface}}",
            "  ip address {{link5_ip1}} {{link5_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_lo0_ip}} {{router4_lo0_mask}}",
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router4_link5_iface}}",
            "  ip address {{link5_ip2}} {{link5_mask}}",
            "  no shutdown",
            "interface {{router4_link6_iface}}",
            "  ip address {{link6_ip1}} {{link6_mask}}",
            "  no shutdown"
        ],
        "{{router5_name}}": [
            "interface Loopback0",
            "  ip address {{router5_lo0_ip}} {{router5_lo0_mask}}",
            "interface {{router5_link6_iface}}",
            "  ip address {{link6_ip2}} {{link6_mask}}",
            "  no shutdown"
        ],
        "{{router6_name}}": [
            "interface Loopback0",
            "  ip address {{router6_lo0_ip}} {{router6_lo0_mask}}",
            "interface {{router6_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router6_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router6_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network 0.0.0.0 255.255.255.255 area 0",
