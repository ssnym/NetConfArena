    "testcases": [
        {
            "goal": "Build a hub and spoke VPN with three separate VPN routing instances, each holding its own CE-facing interface.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip vrf interfaces",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router2_link1_iface}}",
                                "ip_address": "{{link1_ip2}}",
                                "vrf": "{{hub_vrf}}",
                                "proto_state": "up"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show ip vrf interfaces",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router4_link4_iface}}",
                                "ip_address": "{{link4_ip1}}",
                                "vrf": "{{spoke_a_vrf}}",
                                "proto_state": "up"
                            },
                            {
                                "interface": "{{router4_link5_iface}}",
                                "ip_address": "{{link5_ip1}}",
                                "vrf": "{{spoke_b_vrf}}",
                                "proto_state": "up"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include ^ rd",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "rd {{rd_hub}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include ^ rd",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "rd {{rd_spoke_a}}"
                            },
                            {
                                "line": "rd {{rd_spoke_b}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Use exactly two route targets to enforce the topology: the hub instance exports {{rt_hub}} and imports {{rt_spoke}}, while each spoke instance exports {{rt_spoke}} and imports {{rt_hub}} only.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "route-target export {{rt_hub}}"
                            },
                            {
                                "line": "route-target import {{rt_spoke}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "route-target export {{rt_spoke}}"
                            },
                            {
                                "line": "route-target import {{rt_hub}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-3",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "all_match",
                        "value": {
                            "line": {
                                "op": "not_contains",
                                "value": "import {{rt_spoke}}"
                            }
                        }
                    }
                }
            ]
        },
        {
            "goal": "Both spoke sites must reach the hub site and the hub site must reach both spoke sites.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router5_name}}",
                    "command": "ping {{router1_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
