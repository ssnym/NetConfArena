    "scenario": "IBGP-Internal BGP",
    "goals": "• Configure IBGP AS {{bgp_as}} on all routers. You are only allowed to use Loopback0 to establish the neighbor adjacency.\n• Advertise the loopback1 interfaces in IBGP and ensure you have full connectivity within AS {{bgp_as}}.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_lo0_ip}} {{router1_lo0_mask}}",
            "interface Loopback1",
            "  ip address {{router1_lo1_ip}} {{router1_lo1_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_lo0_ip}} {{router2_lo0_mask}}",
            "interface Loopback1",
            "  ip address {{router2_lo1_ip}} {{router2_lo1_mask}}",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_lo0_ip}} {{router3_lo0_mask}}",
            "interface Loopback1",
            "  ip address {{router3_lo1_ip}} {{router3_lo1_mask}}",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown",
            "interface {{router3_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_lo0_ip}} {{router4_lo0_mask}}",
            "interface Loopback1",
            "  ip address {{router4_lo1_ip}} {{router4_lo1_mask}}",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router4_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{router1_lo0_network}} 0.0.0.255 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
