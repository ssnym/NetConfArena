    "testcases": [
        {
            "goal": "Configure IBGP AS {{bgp_as}} on all routers. You are only allowed to use Loopback0 to establish the neighbor adjacency.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{router2_lo0_ip}}",
                                "remote_as": "{{bgp_as}}",
                                "bgp_state": "Established"
                            },
                            {
                                "neighbor": "{{router3_lo0_ip}}",
                                "remote_as": "{{bgp_as}}",
                                "bgp_state": "Established"
