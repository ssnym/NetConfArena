        ],
        "{{router2_name}}": [
            "router bgp {{as_a}}",
            "  no bgp default route-target filter",
            "  neighbor {{link2_ip2}} remote-as {{as_b}}",
            "  address-family vpnv4",
            "    neighbor {{link2_ip2}} activate",
            "    neighbor {{link2_ip2}} send-community extended",
            "    neighbor {{router1_loopback0_ip}} next-hop-self",
            "  exit-address-family"
        ],
        "{{router3_name}}": [
            "router bgp {{as_b}}",
            "  no bgp default route-target filter",
            "  neighbor {{link2_ip1}} remote-as {{as_a}}",
            "  address-family vpnv4",
            "    neighbor {{link2_ip1}} activate",
            "    neighbor {{link2_ip1}} send-community extended",
            "    neighbor {{router4_loopback0_ip}} next-hop-self",
            "  exit-address-family"
        ]
    },
    "testcases": [
        {
            "goal": "Both providers agreed to import each other's route target: add those imports on the two PEs.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "route-target export {{rt_a}}"
                            },
                            {
                                "line": "route-target import {{rt_a}}"
                            },
                            {
                                "line": "route-target import {{rt_b}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include route-target",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "route-target export {{rt_b}}"
                            },
                            {
                                "line": "route-target import {{rt_b}}"
                            },
                            {
                                "line": "route-target import {{rt_a}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Build an eBGP session between the two ASBRs, activate it in the VPNv4 address family, and exchange extended communities on it.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip2}}",
                                "bgp_state": "Established",
                                "remote_as": "{{as_b}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include send-community",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "neighbor {{link2_ip2}} send-community extended"
                            }
                        ]
                    }
                },
                {
                    "id": "2-3",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include send-community",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "neighbor {{link2_ip1}} send-community extended"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Keep the VPNv4 routes whose route target the ASBRs do not import, and do not put the inter-AS interface into any VPN routing instance.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include route-target filter",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "no bgp default route-target filter"
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include route-target filter",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "no bgp default route-target filter"
                            }
                        ]
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include ip vrf forwarding",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "3-4",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include ip vrf forwarding",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "Make each ASBR present itself as the next hop of the routes it passes to its own PE.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include next-hop-self",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "neighbor {{router1_loopback0_ip}} next-hop-self"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include next-hop-self",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "neighbor {{router4_loopback0_ip}} next-hop-self"
                            }
                        ]
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "prefix": "{{router4_loopback1_cidr}}",
                                "next_hop": "{{router2_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-4",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "prefix": "{{router1_loopback1_cidr}}",
                                "next_hop": "{{router3_loopback0_ip}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Result: both ASBRs must hold the customer prefixes of both ASes in their VPNv4 table, and the two customer loopbacks must be able to ping each other inside {{vrf_name}}.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "rd": "{{rd_a}}",
                                "prefix": "{{router1_loopback1_cidr}}"
                            },
                            {
                                "rd": "{{rd_b}}",
                                "prefix": "{{router4_loopback1_cidr}}"
                            }
                        ]
                    }
                },
                {
                    "id": "5-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "rd": "{{rd_a}}",
                                "prefix": "{{router1_loopback1_cidr}}"
                            },
                            {
                                "rd": "{{rd_b}}",
                                "prefix": "{{router4_loopback1_cidr}}"
                            }
                        ]
                    }
                },
                {
                    "id": "5-3",
                    "node": "{{router1_name}}",
                    "command": "ping vrf {{vrf_name}} {{router4_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "5-4",
                    "node": "{{router4_name}}",
                    "command": "ping vrf {{vrf_name}} {{router1_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
