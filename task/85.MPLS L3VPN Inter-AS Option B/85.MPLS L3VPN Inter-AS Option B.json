    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  router-id {{router1_loopback0_ip}}",
            "  network {{router1_loopback0_ip}} 0.0.0.0 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback0 force",
            "interface {{router1_link1_iface}}",
            "  mpls ip",
            "ip vrf {{vrf_name}}",
            "  rd {{rd_a}}",
            "  route-target export {{rt_a}}",
            "  route-target import {{rt_a}}",
            "interface Loopback1",
            "  ip vrf forwarding {{vrf_name}}",
            "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
            "router bgp {{as_a}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router2_loopback0_ip}} remote-as {{as_a}}",
            "  neighbor {{router2_loopback0_ip}} update-source Loopback0",
