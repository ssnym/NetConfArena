{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names"
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names"
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "no_overlap": [
                "_link1"
            ],
            "default": "192.168.23.0/24"
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link3": {
            "type": "random_subnet",
            "pool": "link3_pool",
            "prefix_len": "link3_prefix_lens",
            "no_overlap": [
                "_link1",
                "_link2"
            ],
            "default": "192.168.24.0/24"
        },
        "link3_network": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "network"
        },
        "link3_mask": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "netmask"
        },
        "link3_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "prefixlen"
        },
        "link3_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "wildcard"
        },
        "link3_ip1": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 1
        },
        "link3_ip2": {
            "type": "subnet_attr",
            "subnet": "_link3",
            "attr": "host",
            "index": 2
        },
        "link3_media": {
            "type": "choice",
            "options": "link3_media_options"
        },
        "_loopback2": {
            "type": "random_subnet",
            "pool": "r2_loopback_pool",
            "prefix_len": 24,
            "default": "1.1.1.0/24"
        },
        "router2_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "host",
            "index": 1
        },
        "router2_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "netmask"
        },
        "router2_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback2",
            "attr": "network"
        },
        "_loopback3": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": 24,
            "default": "4.4.4.0/24"
        },
        "router3_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "host",
            "index": 1
        },
        "router3_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "netmask"
        },
        "router3_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback3",
            "attr": "network"
        },
        "_loopback4": {
            "type": "random_subnet",
            "pool": "r4_loopback_pool",
            "prefix_len": 24,
            "default": "3.3.3.0/24"
        },
        "router4_loopback_ip": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "host",
            "index": 1
        },
        "router4_loopback_mask": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "netmask"
        },
        "router4_loopback_network": {
            "type": "subnet_attr",
            "subnet": "_loopback4",
            "attr": "network"
        }
    },
    "scenario": "OSPF Virtual Link",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router2_name}}'s Loopback0\n        {{router4_name}}'s Loopback0\n    Area 1:\n        {{router2_name}}'s {{router2_link1_iface}}\n        {{router4_name}}'s {{router4_link2_iface}}\n        {{router3_name}}'s {{router3_link3_iface}}\n        {{router1_name}}'s {{router1_link1_iface}}, {{router1_link2_iface}}, {{router1_link3_iface}}\n    Area 2:\n        {{router3_name}}'s Loopback0\n• Ensure you restore connectivity for the discontiguous backbone area 0.\n• Ensure area 2 has connectivity to the backbone area.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router1_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback_ip}} {{router2_loopback_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback_ip}} {{router3_loopback_mask}}",
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback_ip}} {{router4_loopback_mask}}",
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{link1_network}} {{link1_wildcard}} area 1",
            "  network {{link2_network}} {{link2_wildcard}} area 1",
            "  network {{link3_network}} {{link3_wildcard}} area 1"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 virtual-link {{router4_loopback_ip}}",
            "  area 1 virtual-link {{router3_loopback_ip}}",
            "  network {{router2_loopback_network}} 0.0.0.255 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 1"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 virtual-link {{router2_loopback_ip}}",
            "  network {{router3_loopback_network}} 0.0.0.255 area 2",
            "  network {{link3_network}} {{link3_wildcard}} area 1"
        ],
        "{{router4_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 virtual-link {{router2_loopback_ip}}",
            "  network {{router4_loopback_network}} 0.0.0.255 area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 1"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router2_name}}'s Loopback0\n        {{router4_name}}'s Loopback0\n    Area 1:\n        {{router2_name}}'s {{router2_link1_iface}}\n        {{router4_name}}'s {{router4_link2_iface}}\n        {{router3_name}}'s {{router3_link3_iface}}\n        {{router1_name}}'s {{router1_link1_iface}}, {{router1_link2_iface}}, {{router1_link3_iface}}\n    Area 2:\n        {{router3_name}}'s Loopback0",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router1_link1_iface}}",
                                "area": "1"
                            },
                            {
                                "interface": "{{router1_link2_iface}}",
                                "area": "1"
                            },
                            {
                                "interface": "{{router1_link3_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "0"
                            },
                            {
                                "interface": "{{router2_link1_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router4_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "0"
                            },
                            {
                                "interface": "{{router4_link2_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "Loopback0",
                                "area": "2"
                            },
                            {
                                "interface": "{{router3_link3_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-5",
                    "node": "{{router2_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {},
                    "output": "router_id"
                },
                {
                    "id": "1-6",
                    "node": "{{router4_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {},
                    "output": "router_id"
                }
            ]
        },
        {
            "goal": "Ensure you restore connectivity for the discontiguous backbone area 0.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf virtual-links",
                    "expected_result": {
                        "router_id": "$1-6_{{router4_name}}_router_id$",
                        "state": "up"
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router4_name}}",
                    "command": "show ip ospf virtual-links",
                    "expected_result": {
                        "router_id": "$1-5_{{router2_name}}_router_id$",
                        "state": "up"
                    }
                }
            ]
        },
        {
            "goal": "Ensure area 2 has connectivity to the backbone area.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf virtual-links",
                    "expected_result": {
                        "op": "all_match",
                        "value": [
                            {
                                "router_id": "$1-5_{{router2_name}}_router_id$",
                                "state": "up"
                            },
                            {
                                "router_id": "$1-6_{{router4_name}}_router_id$",
                                "state": "up"
                            }
                        ]
                    }
                }
            ]
        }
    ],
