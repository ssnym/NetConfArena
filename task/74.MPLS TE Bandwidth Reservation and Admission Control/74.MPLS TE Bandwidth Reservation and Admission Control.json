    "testcases": [
        {
            "goal": "On {{router1_name}} build two TE tunnels towards {{router4_name}} Loopback0, each reserving {{tunnel_bandwidth}} kbps.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include tunnel mpls traffic-eng bandwidth",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel mpls traffic-eng bandwidth {{tunnel_bandwidth}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include tunnel destination",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel destination {{router4_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router1_name}}",
                    "command": "show mpls traffic-eng tunnels brief",
                    "expected_result": {
                        "op": "count_match",
                        "match": {
                            "destination": "{{router4_loopback0_ip}}",
                            "state": "up"
                        },
                        "distinct": "tunnel_name",
                        "count": {
                            "op": "==",
                            "value": 2
                        }
                    }
                }
            ]
        },
        {
            "goal": "Both tunnels must end up in the up state.",
