    "testcases": [
        {
            "goal": "Hide the core from customer traceroutes: on the core routers, stop copying the IP TTL into the label header for transit traffic that the router forwards.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include propagate-ttl",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "no mpls ip propagate-ttl forwarded"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include propagate-ttl",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "no mpls ip propagate-ttl forwarded"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include propagate-ttl",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "no mpls ip propagate-ttl forwarded"
                            }
                        ]
                    }
                },
                {
                    "id": "1-4",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include propagate-ttl",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "A traceroute launched from {{router1_name}} towards {{router4_name}} Loopback0 must report the whole label switched path as a single hop.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "traceroute {{router4_loopback0_ip}} source Loopback0",
                    "expected_result": {
                        "op": "all_match",
                        "value": {
                            "ip_address": {
                                "op": "not_in",
                                "value": [
                                    "{{link2_ip2}}",
                                    "{{link3_ip1}}"
                                ]
                            }
                        }
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "traceroute {{router4_loopback0_ip}} source Loopback0",
                    "expected_result": {
                        "op": "count_match",
                        "match": {},
                        "count": {
                            "op": "<=",
                            "value": 2
                        }
                    }
                }
            ]
        },
        {
            "goal": "Traffic that a core router originates itself must keep normal TTL handling, and end-to-end reachability from {{router1_name}} to {{router4_loopback0_ip}} must not change.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include no mpls ip propagate-ttl$",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router1_name}}",
                    "command": "ping {{router4_loopback0_ip}} source Loopback0",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router2_name}}",
                    "command": "ping {{router4_loopback0_ip}} source Loopback0",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
