    "startup_configs": {
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router1_loopback1_ip}} {{router1_loopback1_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "ip route 0.0.0.0 0.0.0.0 {{link1_ip2}}",
            "interface Tunnel{{tunnel_id}}",
            "  ip address {{tunnel_ip1}} {{tunnel_mask}}",
            "  tunnel source {{router1_link1_iface}}",
            "  tunnel destination {{link2_ip2}}",
            "router ospf 1",
            "  router-id {{router1_loopback0_ip}}",
            "  network {{tunnel_network}} {{tunnel_wildcard}} area 0",
            "  network {{router1_loopback1_network}} {{router1_loopback1_wildcard}} area 0"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
            "interface Loopback1",
            "  ip address {{router3_loopback1_ip}} {{router3_loopback1_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "ip route 0.0.0.0 0.0.0.0 {{link2_ip1}}",
            "interface Tunnel{{tunnel_id}}",
            "  ip address {{tunnel_ip2}} {{tunnel_mask}}",
            "  tunnel source {{router3_link2_iface}}",
            "  tunnel destination {{link1_ip1}}",
            "router ospf 1",
            "  router-id {{router3_loopback0_ip}}",
            "  network {{tunnel_network}} {{tunnel_wildcard}} area 0",
            "  network {{router3_loopback1_network}} {{router3_loopback1_wildcard}} area 0"
        ]
    },
