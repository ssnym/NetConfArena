    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router bgp {{router1_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{router2_as}}",
            "  neighbor {{link1_ip2}} advertise-map {{advertise_route_map_name}} exist-map {{exist_route_map_name}}",
            "  neighbor {{link2_ip2}} remote-as {{router3_as}}",
            "  neighbor {{link2_ip2}} advertise-map {{advertise_route_map_name}} exist-map {{exist_route_map_name}}",
            "  no auto-summary",
            "access-list {{advertise_acl_number}} permit {{router1_loopback0_network}} {{router1_loopback0_wildcard}}",
            "access-list {{exist_acl_number}} permit {{router2_loopback0_network}} {{router2_loopback0_wildcard}}",
            "route-map {{advertise_route_map_name}} permit {{advertise_route_map_seq}}",
            "  match ip address {{advertise_acl_number}}",
            "route-map {{exist_route_map_name}} permit {{exist_route_map_seq}}",
            "  match ip address {{exist_acl_number}}"
        ],
        "{{router2_name}}": [
            "router bgp {{router2_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router2_loopback0_network}} mask {{router2_loopback0_mask}}",
            "  neighbor {{link1_ip1}} remote-as {{router1_as}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "router bgp {{router3_as}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link2_ip1}} remote-as {{router1_as}}",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP between AS {{router2_as}} and AS {{router1_as}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip1}}",
                                "remote_as": "{{router1_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link1_ip2}}",
                                "remote_ip": "{{link1_ip1}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip2}}",
                                "remote_as": "{{router2_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link1_ip1}}",
                                "remote_ip": "{{link1_ip2}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure EBGP between AS {{router1_as}} and AS {{router3_as}}.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip2}}",
                                "remote_as": "{{router3_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link2_ip1}}",
                                "remote_ip": "{{link2_ip2}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip1}}",
                                "remote_as": "{{router1_as}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link2_ip2}}",
                                "remote_ip": "{{link2_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router1_name}} to advertise network {{router1_loopback0_cidr}} in BGP.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_cidr}}"
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_cidr}}",
                                "next_hop": "{{link1_ip1}}"
                            }
                        ]
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_cidr}}",
                                "next_hop": "{{link2_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router2_name}} to advertise network {{router2_loopback0_cidr}} in BGP.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router2_loopback0_cidr}}",
                                "next_hop": "{{link1_ip2}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Configure router {{router1_name}} so it does no longer advertise network {{router1_loopback0_cidr}} when network {{router2_loopback0_cidr}} is no longer reachable.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors {{link1_ip2}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip2}}",
                                "advertise_map": {
                                    "op": "not_empty"
                                },
                                "condition_map": {
                                    "op": "not_empty"
                                },
                                "conditional_advertise_status": "Advertise"
                            }
                        ]
                    },
                    "output": "advertise_map"
                },
                {
                    "id": "5-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors {{link1_ip2}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link1_ip2}}",
                                "advertise_map": "$5-1_{{router1_name}}_advertise_map$",
                                "condition_map": {
                                    "op": "not_empty"
                                },
                                "conditional_advertise_status": "Advertise"
                            }
                        ]
                    },
                    "output": "condition_map"
                },
                {
                    "id": "5-3",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors {{link2_ip2}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip2}}",
                                "advertise_map": "$5-1_{{router1_name}}_advertise_map$",
                                "condition_map": "$5-2_{{router1_name}}_condition_map$",
                                "conditional_advertise_status": "Advertise"
                            }
                        ]
                    }
                },
                {
                    "id": "5-4",
                    "node": "{{router1_name}}",
                    "command": "show route-map",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "name": "$5-1_{{router1_name}}_advertise_map$",
                                "action": "permit",
                                "match_ip_filter_names": {
                                    "op": "not_empty"
                                }
                            },
                            {
                                "name": "$5-2_{{router1_name}}_condition_map$",
                                "action": "permit",
                                "match_ip_filter_names": {
                                    "op": "not_empty"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
