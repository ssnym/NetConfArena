{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router2_as": {
            "type": "choice",
            "options": "router2_as_options"
        },
        "router1_as": {
            "type": "choice",
            "options": "router1_as_options",
            "different_from": [
                "router2_as"
            ]
        },
        "router3_as": {
            "type": "choice",
            "options": "router3_as_options",
            "different_from": [
                "router2_as",
                "router1_as"
            ]
        },
        "advertise_acl_number": {
            "type": "choice",
            "options": "advertise_acl_numbers"
        },
        "exist_acl_number": {
            "type": "choice",
            "options": "exist_acl_numbers",
            "different_from": [
                "advertise_acl_number"
            ]
        },
        "advertise_route_map_name": {
            "type": "choice",
            "options": "advertise_route_map_names"
        },
        "exist_route_map_name": {
            "type": "choice",
            "options": "exist_route_map_names",
            "different_from": [
                "advertise_route_map_name"
            ]
        },
        "advertise_route_map_seq": {
            "type": "choice",
            "options": "advertise_route_map_seqs"
        },
        "exist_route_map_seq": {
            "type": "choice",
            "options": "exist_route_map_seqs"
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.23.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_cidr": {
            "type": "format",
            "template": "{link2_network}/{link2_prefix_len}"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "_router1_loopback0": {
            "type": "random_subnet",
            "pool": "r1_loopback0_pool",
            "prefix_len": "r1_loopback0_prefix_lens",
            "default": "2.2.2.0/24",
            "no_overlap": [
                "_link1",
                "_link2"
            ]
        },
        "router1_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "network"
        },
        "router1_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "netmask"
        },
        "router1_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "prefixlen"
        },
        "router1_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "wildcard"
        },
        "router1_loopback0_cidr": {
            "type": "format",
            "template": "{router1_loopback0_network}/{router1_loopback0_prefix_len}"
        },
        "router1_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router2_loopback0": {
            "type": "random_subnet",
            "pool": "r2_loopback0_pool",
            "prefix_len": "r2_loopback0_prefix_lens",
            "default": "1.1.1.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_router1_loopback0"
            ]
        },
        "router2_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "network"
        },
        "router2_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "netmask"
        },
        "router2_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "prefixlen"
        },
        "router2_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "wildcard"
        },
        "router2_loopback0_cidr": {
            "type": "format",
            "template": "{router2_loopback0_network}/{router2_loopback0_prefix_len}"
        },
        "router2_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "host",
            "index": 1
        },
        "_router3_loopback0": {
            "type": "random_subnet",
            "pool": "r3_loopback0_pool",
            "prefix_len": "r3_loopback0_prefix_lens",
            "default": "3.3.3.0/24",
            "no_overlap": [
                "_link1",
                "_link2",
                "_router1_loopback0",
                "_router2_loopback0"
            ]
        },
        "router3_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "network"
        },
        "router3_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "netmask"
        },
        "router3_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "prefixlen"
        },
        "router3_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "wildcard"
        },
        "router3_loopback0_cidr": {
            "type": "format",
            "template": "{router3_loopback0_network}/{router3_loopback0_prefix_len}"
        },
        "router3_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "host",
            "index": 1
        }
    },
    "scenario": "BGP Conditional Advertisement",
    "goals": "\u2022 Configure EBGP between AS {{router2_as}} and AS {{router1_as}}.\n  AS {{router2_as}}: {{router2_name}}\n  AS {{router1_as}}: {{router1_name}}\n\u2022 Configure EBGP between AS {{router1_as}} and AS {{router3_as}}.\n  AS {{router1_as}}: {{router1_name}}\n  AS {{router3_as}}: {{router3_name}}\n\u2022 Configure router {{router1_name}} to advertise network {{router1_loopback0_cidr}} in BGP.\n\u2022 Configure router {{router2_name}} to advertise network {{router2_loopback0_cidr}} in BGP.\n\u2022 Configure router {{router1_name}} so it does no longer advertise network {{router1_loopback0_cidr}} when network {{router2_loopback0_cidr}} is no longer reachable.",
