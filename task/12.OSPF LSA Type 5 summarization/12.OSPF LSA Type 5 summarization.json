{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names"
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "no_overlap": [
                "_link1"
            ],
            "default": "192.168.23.0/24"
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_sam_block": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": 21,
            "default": "172.16.0.0/21"
        },
        "sam_summary1_network": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 22,
            "n": 0,
            "attr": "network"
        },
        "sam_summary1_mask": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 22,
            "n": 0,
            "attr": "netmask"
        },
        "sam_summary2_network": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 22,
            "n": 1,
            "attr": "network"
        },
        "sam_summary2_mask": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 22,
            "n": 1,
            "attr": "netmask"
        },
        "sam_lo0_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 0,
            "attr": "host",
            "index": 1
        },
        "sam_lo1_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 1,
            "attr": "host",
            "index": 1
        },
        "sam_lo2_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 2,
            "attr": "host",
            "index": 1
        },
        "sam_lo3_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 3,
            "attr": "host",
            "index": 1
        },
        "sam_lo4_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 4,
            "attr": "host",
            "index": 1
        },
        "sam_lo5_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 5,
            "attr": "host",
            "index": 1
        },
        "sam_lo6_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 6,
            "attr": "host",
            "index": 1
        },
        "sam_lo7_ip": {
            "type": "subnet_nth",
            "subnet": "_sam_block",
            "new_prefix": 24,
            "n": 7,
            "attr": "host",
            "index": 1
        }
    },
    "scenario": "OSPF LSA Type 5 summarization",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router2_name}}'s {{router2_link1_iface}}\n        {{router1_name}}'s {{router1_link1_iface}}\n    Area 1:\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}\n• Router {{router3_name}} has a number of loopback interfaces. Redistribute them in OSPF so they show up as external routes on router {{router2_name}}.\n• Configure OSPF so there are two summaries for the loopback interfaces of router {{router3_name}}. Use the most optimal summaries.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{sam_lo0_ip}} 255.255.255.0",
            "interface Loopback1",
            "  ip address {{sam_lo1_ip}} 255.255.255.0",
            "interface Loopback2",
            "  ip address {{sam_lo2_ip}} 255.255.255.0",
            "interface Loopback3",
            "  ip address {{sam_lo3_ip}} 255.255.255.0",
            "interface Loopback4",
            "  ip address {{sam_lo4_ip}} 255.255.255.0",
            "interface Loopback5",
            "  ip address {{sam_lo5_ip}} 255.255.255.0",
            "interface Loopback6",
            "  ip address {{sam_lo6_ip}} 255.255.255.0",
            "interface Loopback7",
            "  ip address {{sam_lo7_ip}} 255.255.255.0",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 1"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network 0.0.0.0 255.255.255.255 area 0"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  summary-address {{sam_summary1_network}} {{sam_summary1_mask}}",
            "  summary-address {{sam_summary2_network}} {{sam_summary2_mask}}",
            "  redistribute connected subnets",
            "  network {{link2_network}} {{link2_wildcard}} area 1"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router2_name}}'s {{router2_link1_iface}}\n        {{router1_name}}'s {{router1_link1_iface}}\n    Area 1:\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "interface": "{{router2_link1_iface}}",
                        "area": "0"
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router1_link1_iface}}",
                                "area": "0"
                            },
                            {
                                "interface": "{{router1_link2_iface}}",
                                "area": "1"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "interface": "{{router3_link2_iface}}",
                        "area": "1"
                    }
                }
            ]
        },
        {
            "goal": "Router {{router3_name}} has a number of loopback interfaces. Redistribute them in OSPF so they show up as external routes on router {{router2_name}}.",
            "testcase": [
                {
                    "id": "2",
                    "node": "{{router3_name}}",
                    "command": "show ip protocols | section ospf",
                    "expected_result": {
                        "redistribute": {
                            "op": "contains_all",
                            "value": [
                                "connected, includes subnets in redistribution"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "goal": "Configure OSPF so there are two summaries for the loopback interfaces of router {{router3_name}}. Use the most optimal summaries.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip ospf database external",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "link_state_id": "{{sam_summary1_network}}",
                                "network_mask": "/22"
                            },
                            {
                                "link_state_id": "{{sam_summary2_network}}",
                                "network_mask": "/22"
                            }
                        ]
                    }
                }
            ]
        }
    ],
