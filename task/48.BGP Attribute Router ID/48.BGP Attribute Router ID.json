            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.12.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.14.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
