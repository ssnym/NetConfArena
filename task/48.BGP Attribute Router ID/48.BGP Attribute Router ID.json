    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "router bgp {{as1}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  network {{router1_loopback0_network}} mask {{router1_loopback0_mask}}",
            "  neighbor {{link1_ip2}} remote-as {{as2}}",
            "  neighbor {{link2_ip2}} remote-as {{as4}}",
            "  no auto-summary"
        ],
        "{{router2_name}}": [
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "router bgp {{as2}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{link1_ip1}} remote-as {{as1}}",
            "  neighbor {{link3_ip2}} remote-as {{as3}}",
            "  no auto-summary"
        ],
        "{{router3_name}}": [
            "interface {{router3_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown",
            "router bgp {{as3}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  bgp bestpath compare-routerid",
            "  neighbor {{link3_ip1}} remote-as {{as2}}",
            "  neighbor {{link4_ip2}} remote-as {{as4}}",
            "  no auto-summary"
        ],
        "{{router4_name}}": [
            "interface {{router4_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router4_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router4_name}}": [
            "router bgp {{as4}}",
            "  no synchronization",
            "  bgp router-id {{router4_bgp_router_id}}",
            "  bgp log-neighbor-changes",
            "  neighbor {{link2_ip1}} remote-as {{as1}}",
            "  neighbor {{link4_ip1}} remote-as {{as3}}",
            "  no auto-summary"
        ]
    },
    "testcases": [
        {
            "goal": "Configure EBGP on router {{router4_name}} with its directly connected BGP neighbors.",
            "testcase": [
                {
                    "id": "1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{link2_ip1}}",
                                "remote_as": "{{as1}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link2_ip2}}",
                                "remote_ip": "{{link2_ip1}}"
                            },
                            {
                                "neighbor": "{{link4_ip1}}",
                                "remote_as": "{{as3}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{link4_ip2}}",
                                "remote_ip": "{{link4_ip1}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Router {{router3_name}} should then have two paths to reach router {{router1_name}}'s loopback0 network.",
            "testcase": [
                {
                    "id": "3",
                    "node": "{{router3_name}}",
                    "command": "show ip bgp",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router1_loopback0_cidr}}",
                                "next_hop": "{{link3_ip1}}"
                            },
                            {
                                "network": "{{router1_loopback0_cidr}}",
                                "next_hop": "{{link4_ip2}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Ensure router {{router3_name}} sends traffic to router {{router4_name}} to reach router {{router1_name}}'s loopback0 network. You are only allowed to make changes on router {{router4_name}}, and you must achieve this by configuring router {{router4_name}}'s BGP router ID.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router4_name}}",
                    "command": "show ip bgp summary",
                    "expected_result": {
                        "local_as": "{{as4}}",
                        "router_id": {
                            "op": "not_in",
                            "value": [
                                "{{link2_ip2}}",
                                "{{link4_ip2}}"
                            ]
                        }
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include bgp router-id",
                    "expected_result": {
                        "line": {
                            "op": "contains",
                            "value": "bgp router-id"
                        }
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router3_name}}",
                    "command": "show ip route",
                    "expected_result": {
                        "network": "{{router1_loopback0_network}}",
                        "prefix_length": "{{router1_loopback0_prefix_len}}",
                        "nexthop_ip": "{{link4_ip2}}"
                    }
                },
                {
                    "id": "4-5",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include route-map|set|local-preference|weight|as-path|metric|med",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-6",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include route-map|set|local-preference|weight|as-path|metric|med",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-7",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include bgp router-id",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-8",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include bgp router-id",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "4-9",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include bgp router-id",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
