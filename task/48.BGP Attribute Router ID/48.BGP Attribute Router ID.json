{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "router4_name": {
            "type": "choice",
            "options": "r4_names",
            "different_from": [
                "router1_name",
                "router2_name",
                "router3_name"
            ]
        },
        "as1": {
            "type": "choice",
            "options": "as1_options"
        },
        "as2": {
            "type": "choice",
            "options": "as2_options",
            "different_from": [
                "as1"
            ]
        },
        "as3": {
            "type": "choice",
            "options": "as3_options",
            "different_from": [
                "as1",
                "as2"
            ]
        },
        "as4": {
            "type": "choice",
            "options": "as4_options",
            "different_from": [
                "as1",
                "as2",
                "as3"
            ]
