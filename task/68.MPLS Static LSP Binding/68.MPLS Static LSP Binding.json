{
    "params": {
        "router1_name": {
            "type": "choice",
            "options": "r1_names"
        },
        "router2_name": {
            "type": "choice",
            "options": "r2_names",
            "different_from": [
                "router1_name"
            ]
        },
        "router3_name": {
            "type": "choice",
            "options": "r3_names",
            "different_from": [
                "router1_name",
                "router2_name"
            ]
        },
        "link1_media": {
            "type": "choice",
            "options": "link1_media_options"
        },
        "_link1": {
            "type": "random_subnet",
            "pool": "link1_pool",
            "prefix_len": "link1_prefix_lens",
            "default": "192.168.1.0/24"
        },
        "link1_network": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "network"
        },
        "link1_mask": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "netmask"
        },
        "link1_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "wildcard"
        },
        "link1_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "prefixlen"
        },
        "link1_cidr": {
            "type": "format",
            "template": "{link1_network}/{link1_prefix_len}"
        },
        "link1_ip1": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 1
        },
        "link1_ip2": {
            "type": "subnet_attr",
            "subnet": "_link1",
            "attr": "host",
            "index": 2
        },
        "link2_media": {
            "type": "choice",
            "options": "link2_media_options"
        },
        "_link2": {
            "type": "random_subnet",
            "pool": "link2_pool",
            "prefix_len": "link2_prefix_lens",
            "default": "192.168.2.0/24",
            "no_overlap": [
                "_link1"
            ]
        },
        "link2_network": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "network"
        },
        "link2_mask": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "netmask"
        },
        "link2_wildcard": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "wildcard"
        },
        "link2_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "prefixlen"
        },
        "link2_cidr": {
            "type": "format",
            "template": "{link2_network}/{link2_prefix_len}"
        },
        "link2_ip1": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 1
        },
        "link2_ip2": {
            "type": "subnet_attr",
            "subnet": "_link2",
            "attr": "host",
            "index": 2
        },
        "_router1_loopback0": {
            "type": "random_subnet",
            "pool": "r1_loopback_pool",
            "prefix_len": [
                32
            ],
            "default": "1.1.1.1/32"
        },
        "router1_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "host",
            "index": 1
        },
        "router1_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "network"
        },
        "router1_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "netmask"
        },
        "router1_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "wildcard"
        },
        "router1_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router1_loopback0",
            "attr": "prefixlen"
        },
        "router1_loopback0_cidr": {
            "type": "format",
            "template": "{router1_loopback0_network}/{router1_loopback0_prefix_len}"
        },
        "_router2_loopback0": {
            "type": "random_subnet",
            "pool": "r2_loopback_pool",
            "prefix_len": [
                32
            ],
            "default": "2.2.2.2/32"
        },
        "router2_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "host",
            "index": 1
        },
        "router2_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "network"
        },
        "router2_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "netmask"
        },
        "router2_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "wildcard"
        },
        "router2_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router2_loopback0",
            "attr": "prefixlen"
        },
        "router2_loopback0_cidr": {
            "type": "format",
            "template": "{router2_loopback0_network}/{router2_loopback0_prefix_len}"
        },
        "_router3_loopback0": {
            "type": "random_subnet",
            "pool": "r3_loopback_pool",
            "prefix_len": [
                32
            ],
            "default": "3.3.3.3/32"
        },
        "router3_loopback0_ip": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "host",
            "index": 1
        },
        "router3_loopback0_network": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "network"
        },
        "router3_loopback0_mask": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "netmask"
        },
        "router3_loopback0_wildcard": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "wildcard"
        },
        "router3_loopback0_prefix_len": {
            "type": "subnet_attr",
            "subnet": "_router3_loopback0",
            "attr": "prefixlen"
        },
        "router3_loopback0_cidr": {
            "type": "format",
            "template": "{router3_loopback0_network}/{router3_loopback0_prefix_len}"
        },
        "static_label_in": {
            "type": "choice",
            "options": "static_label_in_options"
        },
        "static_label_range_min": {
            "type": "choice",
            "options": "static_label_range_min_options"
        },
        "static_label_range_max": {
            "type": "choice",
            "options": "static_label_range_max_options"
        },
        "dynamic_label_min": {
            "type": "choice",
            "options": "dynamic_label_min_options"
        },
        "dynamic_label_max": {
            "type": "choice",
            "options": "dynamic_label_max_options"
        }
    },
    "scenario": "MPLS Static LSP Binding",
    "goals": "• MPLS forwarding and LDP are already enabled on both core links, all LDP sessions are operational, and every router already uses its Loopback0 address as LDP router-id.\n• The label switched path towards {{router3_name}} Loopback0 ({{router3_loopback0_cidr}}) currently uses a dynamically allocated label on {{router2_name}}, which changes after every restart. A monitoring system needs a fixed, predictable label value for that prefix.\n• Pin the label of that one prefix so that:\n    {{router2_name}} accepts incoming label {{static_label_in}} for {{router3_loopback0_cidr}} and pops it towards {{router3_name}} at next hop {{link2_ip2}}\n    {{router1_name}} therefore imposes label {{static_label_in}} when it sends traffic towards {{router3_loopback0_cidr}}, without any static configuration of its own\n    {{router3_name}} keeps its default behaviour for its own Loopback0 and must not receive any static binding either\n• Only the label of {{router3_loopback0_cidr}} on {{router2_name}} may be pinned. LDP must stay enabled and keep running on both links, all other prefixes must keep their dynamic labels, and the path must still forward traffic end to end.",
    "topology_model": {
        "nodes": [
            "r1",
            "r2",
            "r3"
        ],
        "links": [
            {
                "id": "link1",
                "nodes": [
                    "r1",
                    "r2"
                ],
                "media": "{{link1_media}}"
            },
            {
                "id": "link2",
                "nodes": [
                    "r2",
                    "r3"
                ],
                "media": "{{link2_media}}"
            }
        ]
    },
    "topology_attributes": {
        "nodes": {
            "r1": {
                "type": "C7200",
                "label": {
                    "text": "{{router1_name}}",
                    "x": 19.5,
                    "y": -25.0
                },
                "x": -400.0,
                "y": 0.0
            },
            "r2": {
                "type": "C7200",
                "label": {
                    "text": "{{router2_name}}",
                    "x": 19.5,
                    "y": -25.0
                },
                "x": -200.0,
                "y": 0.0
            },
            "r3": {
                "type": "C7200",
                "label": {
                    "text": "{{router3_name}}",
                    "x": 19.5,
                    "y": -25.0
                },
                "x": 0.0,
                "y": 0.0
            }
        },
        "notes": [
            {
                "color": "#0000ff",
                "text": "{{link1_network}} /{{link1_prefix_len}}",
                "x": -300.0,
                "y": -30.0
            },
            {
                "color": "#0000ff",
                "text": "{{link2_network}} /{{link2_prefix_len}}",
                "x": -100.0,
                "y": -30.0
            }
        ]
    },
    "startup_configs": {
        "{{router1_name}}": [
            "interface Loopback0",
            "  ip address {{router1_loopback0_ip}} {{router1_loopback0_mask}}",
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  router-id {{router1_loopback0_ip}}",
            "  network {{router1_loopback0_ip}} 0.0.0.0 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "mpls label range {{dynamic_label_min}} {{dynamic_label_max}} static {{static_label_range_min}} {{static_label_range_max}}",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback0 force",
            "interface {{router1_link1_iface}}",
            "  mpls ip"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{router2_loopback0_ip}} {{router2_loopback0_mask}}",
            "interface {{router2_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router2_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  router-id {{router2_loopback0_ip}}",
            "  network {{router2_loopback0_ip}} 0.0.0.0 area 0",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "mpls label range {{dynamic_label_min}} {{dynamic_label_max}} static {{static_label_range_min}} {{static_label_range_max}}",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback0 force",
            "interface {{router2_link1_iface}}",
            "  mpls ip",
            "interface {{router2_link2_iface}}",
            "  mpls ip"
        ],
        "{{router3_name}}": [
            "interface Loopback0",
            "  ip address {{router3_loopback0_ip}} {{router3_loopback0_mask}}",
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  router-id {{router3_loopback0_ip}}",
            "  network {{router3_loopback0_ip}} 0.0.0.0 area 0",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "mpls label range {{dynamic_label_min}} {{dynamic_label_max}} static {{static_label_range_min}} {{static_label_range_max}}",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback0 force",
            "interface {{router3_link2_iface}}",
            "  mpls ip"
        ]
    },
    "groundtruth_configs": {
        "{{router2_name}}": [
            "mpls static binding ipv4 {{router3_loopback0_ip}} 255.255.255.255 {{static_label_in}}"
        ]
    },
    "testcases": [
        {
            "goal": "{{router2_name}} accepts incoming label {{static_label_in}} for {{router3_loopback0_cidr}} and pops it towards {{router3_name}} at next hop {{link2_ip2}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include mpls static binding",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "mpls static binding ipv4 {{router3_loopback0_ip}} 255.255.255.255 {{static_label_in}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router2_name}}",
                    "command": "show mpls forwarding-table {{router3_loopback0_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "local_label": "{{static_label_in}}",
                                "outgoing_label": "Pop Label",
                                "prefix": "{{router3_loopback0_cidr}}",
                                "interface": "{{router2_link2_iface}}",
                                "next_hop": "{{link2_ip2}}"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "{{router1_name}} therefore imposes label {{static_label_in}} when it sends traffic towards {{router3_loopback0_cidr}}, without any static configuration of its own.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show mpls forwarding-table {{router3_loopback0_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "outgoing_label": "{{static_label_in}}",
                                "prefix": "{{router3_loopback0_cidr}}",
                                "next_hop": "{{link1_ip2}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include mpls static binding",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "{{router3_name}} keeps its default behaviour for its own Loopback0 and must not receive any static binding either.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include mpls static binding",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "LDP must stay enabled and keep running on both links, all other prefixes must keep their dynamic labels, and the path must still forward traffic end to end.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router2_name}}",
                    "command": "show mpls ldp neighbor",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "peer_ldp_ident": "{{router1_loopback0_ip}}:0",
                                "local_ldp_ident": "{{router2_loopback0_ip}}:0",
                                "state": "Oper"
                            },
                            {
                                "peer_ldp_ident": "{{router3_loopback0_ip}}:0",
                                "local_ldp_ident": "{{router2_loopback0_ip}}:0",
                                "state": "Oper"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router1_name}}",
                    "command": "ping {{router3_loopback0_ip}} source Loopback0",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router3_name}}",
                    "command": "ping {{router1_loopback0_ip}} source Loopback0",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
