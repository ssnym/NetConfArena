    "scenario": "OSPF LSA Type 3 summarization",
    "goals": "• Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router5_name}}'s {{router5_link1_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}\n    Area 1:\n        {{router5_name}}'s {{router5_link3_iface}}\n        {{router4_name}}'s {{router4_link3_iface}}, Loopback0, Loopback1, Loopback2, Loopback3\n    Area 2:\n        {{router3_name}}'s {{router3_link4_iface}}\n        {{router2_name}}'s {{router2_link4_iface}}, Loopback0, Loopback1, Loopback2, Loopback3, Loopback4, Loopback5, Loopback6, Loopback7\n• Router {{router4_name}} and {{router2_name}} have multiple loopback interfaces. Configure the network so Area 0 only sees a summary of these networks. Use the most optimal summary.",
    "startup_configs": {
        "{{router1_name}}": [
            "interface {{router1_link1_iface}}",
            "  ip address {{link1_ip1}} {{link1_mask}}",
            "  no shutdown",
            "interface {{router1_link2_iface}}",
            "  ip address {{link2_ip1}} {{link2_mask}}",
            "  no shutdown"
        ],
        "{{router2_name}}": [
            "interface Loopback0",
            "  ip address {{fluorite_lo0_ip}} 255.255.255.0",
            "interface Loopback1",
            "  ip address {{fluorite_lo1_ip}} 255.255.255.0",
            "interface Loopback2",
            "  ip address {{fluorite_lo2_ip}} 255.255.255.0",
            "interface Loopback3",
            "  ip address {{fluorite_lo3_ip}} 255.255.255.0",
            "interface Loopback4",
            "  ip address {{fluorite_lo4_ip}} 255.255.255.0",
            "interface Loopback5",
            "  ip address {{fluorite_lo5_ip}} 255.255.255.0",
            "interface Loopback6",
            "  ip address {{fluorite_lo6_ip}} 255.255.255.0",
            "interface Loopback7",
            "  ip address {{fluorite_lo7_ip}} 255.255.255.0",
            "interface {{router2_link4_iface}}",
            "  ip address {{link4_ip2}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router3_name}}": [
            "interface {{router3_link2_iface}}",
            "  ip address {{link2_ip2}} {{link2_mask}}",
            "  no shutdown",
            "interface {{router3_link4_iface}}",
            "  ip address {{link4_ip1}} {{link4_mask}}",
            "  no shutdown"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{talc_lo0_ip}} 255.255.255.0",
            "interface Loopback1",
            "  ip address {{talc_lo1_ip}} 255.255.255.0",
            "interface Loopback2",
            "  ip address {{talc_lo2_ip}} 255.255.255.0",
            "interface Loopback3",
            "  ip address {{talc_lo3_ip}} 255.255.255.0",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown"
        ],
        "{{router5_name}}": [
            "interface {{router5_link3_iface}}",
            "  ip address {{link3_ip1}} {{link3_mask}}",
            "  no shutdown",
            "interface {{router5_link1_iface}}",
            "  ip address {{link1_ip2}} {{link1_mask}}",
            "  no shutdown"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network 0.0.0.0 255.255.255.255 area 0"
        ],
        "{{router2_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network 0.0.0.0 255.255.255.255 area 2"
        ],
        "{{router3_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 2 range {{fluorite_summary_network}} {{fluorite_summary_mask}}",
            "  network {{link2_network}} {{link2_wildcard}} area 0",
            "  network {{link4_network}} {{link4_wildcard}} area 2"
        ],
        "{{router4_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  network 0.0.0.0 255.255.255.255 area 1"
        ],
        "{{router5_name}}": [
            "router ospf 1",
            "  log-adjacency-changes",
            "  area 1 range {{talc_summary_network}} {{talc_summary_mask}}",
            "  network {{link1_network}} {{link1_wildcard}} area 0",
            "  network {{link3_network}} {{link3_wildcard}} area 1"
        ]
    },
    "testcases": [
        {
            "goal": "Configure OSPF on all routers, with the areas specified as follows:\n    Area 0:\n        {{router1_name}}'s {{router1_link1_iface}}\n        {{router1_name}}'s {{router1_link2_iface}}\n        {{router5_name}}'s {{router5_link1_iface}}\n        {{router3_name}}'s {{router3_link2_iface}}\n    Area 1:\n        {{router5_name}}'s {{router5_link3_iface}}\n        {{router4_name}}'s {{router4_link3_iface}}, Loopback0, Loopback1, Loopback2, Loopback3\n    Area 2:\n        {{router3_name}}'s {{router3_link4_iface}}\n        {{router2_name}}'s {{router2_link4_iface}}, Loopback0, Loopback1, Loopback2, Loopback3, Loopback4, Loopback5, Loopback6, Loopback7",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show ip ospf interface brief",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "interface": "{{router1_link1_iface}}",
                                "area": "0"
                            },
                            {
