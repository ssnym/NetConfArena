            "  neighbor {{router4_loopback2_ip}} update-source Loopback2",
            "  no auto-summary",
            "  address-family vpnv4",
            "    neighbor {{router4_loopback2_ip}} activate",
            "    neighbor {{router4_loopback2_ip}} send-community extended",
            "  exit-address-family",
            "  address-family ipv4 vrf {{vrf_name}}",
            "    redistribute connected",
            "    no synchronization",
            "  exit-address-family"
        ],
        "{{router4_name}}": [
            "interface Loopback0",
            "  ip address {{router4_loopback0_ip}} {{router4_loopback0_mask}}",
            "interface {{router4_link3_iface}}",
            "  ip address {{link3_ip2}} {{link3_mask}}",
            "  no shutdown",
            "router ospf 1",
            "  router-id {{router4_loopback0_ip}}",
            "  network {{router4_loopback0_ip}} 0.0.0.0 area 0",
            "  network {{link3_network}} {{link3_wildcard}} area 0",
            "interface Loopback2",
            "  ip address {{router4_loopback2_ip}} {{router4_loopback2_mask}}",
            "ip vrf {{vrf_name}}",
            "  rd {{rd}}",
            "  route-target export {{rt}}",
            "  route-target import {{rt}}",
            "interface Loopback1",
            "  ip vrf forwarding {{vrf_name}}",
            "  ip address {{router4_loopback1_ip}} {{router4_loopback1_mask}}",
            "router bgp {{as_number}}",
            "  no synchronization",
            "  bgp log-neighbor-changes",
            "  neighbor {{router1_loopback2_ip}} remote-as {{as_number}}",
            "  neighbor {{router1_loopback2_ip}} update-source Loopback2",
            "  no auto-summary",
            "  address-family vpnv4",
            "    neighbor {{router1_loopback2_ip}} activate",
            "    neighbor {{router1_loopback2_ip}} send-community extended",
            "  exit-address-family",
            "  address-family ipv4 vrf {{vrf_name}}",
            "    redistribute connected",
            "    no synchronization",
            "  exit-address-family"
        ]
    },
    "groundtruth_configs": {
        "{{router1_name}}": [
            "interface Tunnel{{tunnel_id}}",
            "  ip address {{tunnel_ip1}} {{tunnel_mask}}",
            "  tunnel source Loopback0",
            "  tunnel destination {{router4_loopback0_ip}}",
            "  mpls ip",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback2 force",
            "router ospf {{overlay_process}}",
            "  router-id {{router1_loopback2_ip}}",
            "  network {{tunnel_network}} {{tunnel_wildcard}} area 0",
            "  network {{router1_loopback2_ip}} 0.0.0.0 area 0"
        ],
        "{{router4_name}}": [
            "interface Tunnel{{tunnel_id}}",
            "  ip address {{tunnel_ip2}} {{tunnel_mask}}",
            "  tunnel source Loopback0",
            "  tunnel destination {{router1_loopback0_ip}}",
            "  mpls ip",
            "mpls label protocol ldp",
            "mpls ldp router-id Loopback2 force",
            "router ospf {{overlay_process}}",
            "  router-id {{router4_loopback2_ip}}",
            "  network {{tunnel_network}} {{tunnel_wildcard}} area 0",
            "  network {{router4_loopback2_ip}} 0.0.0.0 area 0"
        ]
    },
    "testcases": [
        {
            "goal": "Build a GRE tunnel Tunnel{{tunnel_id}} between the two PEs, sourced from Loopback0 and destined to the remote Loopback0, addressed out of {{tunnel_cidr}}.",
            "testcase": [
                {
                    "id": "1-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include tunnel source|tunnel destination",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel source Loopback0"
                            },
                            {
                                "line": "tunnel destination {{router4_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-2",
                    "node": "{{router4_name}}",
                    "command": "show running-config | include tunnel source|tunnel destination",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "tunnel source Loopback0"
                            },
                            {
                                "line": "tunnel destination {{router1_loopback0_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "1-3",
                    "node": "{{router1_name}}",
                    "command": "ping {{tunnel_ip2}}",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "Advertise the endpoint loopbacks to each other through the tunnel only, with a second OSPF process {{overlay_process}} covering the tunnel subnet and the local Loopback2 host route.",
            "testcase": [
                {
                    "id": "2-1",
                    "node": "{{router1_name}}",
                    "command": "show running-config | include router ospf",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "line": "router ospf {{overlay_process}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-2",
                    "node": "{{router1_name}}",
                    "command": "show ip route {{router4_loopback2_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "network": "{{router4_loopback2_cidr}}",
                                "protocol": "ospf",
                                "nexthop_ip": "{{tunnel_ip2}}"
                            }
                        ]
                    }
                },
                {
                    "id": "2-3",
                    "node": "{{router2_name}}",
                    "command": "show ip route {{router4_loopback2_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "2-4",
                    "node": "{{router3_name}}",
                    "command": "show ip route {{router1_loopback2_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        },
        {
            "goal": "Enable MPLS forwarding with LDP on the tunnel and take the LDP router-id from Loopback2, so the two PEs build an LDP session and a label switched path across the GRE core.",
            "testcase": [
                {
                    "id": "3-1",
                    "node": "{{router1_name}}",
                    "command": "show mpls ldp neighbor",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "peer_ldp_ident": "{{router4_loopback2_ip}}:0",
                                "local_ldp_ident": "{{router1_loopback2_ip}}:0",
                                "state": "Oper",
                                "discovery_sources": [
                                    "Tunnel{{tunnel_id}}"
                                ]
                            }
                        ]
                    }
                },
                {
                    "id": "3-2",
                    "node": "{{router4_name}}",
                    "command": "show mpls ldp neighbor",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "peer_ldp_ident": "{{router1_loopback2_ip}}:0",
                                "local_ldp_ident": "{{router4_loopback2_ip}}:0",
                                "state": "Oper"
                            }
                        ]
                    }
                },
                {
                    "id": "3-3",
                    "node": "{{router1_name}}",
                    "command": "show mpls forwarding-table {{router4_loopback2_ip}} 255.255.255.255",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "prefix": "{{router4_loopback2_cidr}}",
                                "interface": {
                                    "op": "regex",
                                    "value": "^Tu(nnel)?{{tunnel_id}}$"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "The VPNv4 session must come up between the endpoint loopbacks, both customer prefixes must appear in the VPNv4 table, and the two customer loopbacks must be able to ping each other inside {{vrf_name}}.",
            "testcase": [
                {
                    "id": "4-1",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp neighbors",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "neighbor": "{{router4_loopback2_ip}}",
                                "bgp_state": "Established",
                                "localhost_ip": "{{router1_loopback2_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-2",
                    "node": "{{router1_name}}",
                    "command": "show ip bgp vpnv4 all",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "rd": "{{rd}}",
                                "prefix": "{{router1_loopback1_cidr}}"
                            },
                            {
                                "rd": "{{rd}}",
                                "prefix": "{{router4_loopback1_cidr}}",
                                "next_hop": "{{router4_loopback2_ip}}"
                            }
                        ]
                    }
                },
                {
                    "id": "4-3",
                    "node": "{{router1_name}}",
                    "command": "ping vrf {{vrf_name}} {{router4_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                },
                {
                    "id": "4-4",
                    "node": "{{router4_name}}",
                    "command": "ping vrf {{vrf_name}} {{router1_loopback1_ip}} source Loopback1",
                    "expected_result": {
                        "op": "contains_all",
                        "value": [
                            {
                                "success_pct": {
                                    "op": ">=",
                                    "value": "80"
                                }
                            }
                        ]
                    }
                }
            ]
        },
        {
            "goal": "{{router2_name}} and {{router3_name}} must have no MPLS configuration at all.",
            "testcase": [
                {
                    "id": "5-1",
                    "node": "{{router2_name}}",
                    "command": "show running-config | include mpls",
                    "expected_result": {
                        "op": "empty"
                    }
                },
                {
                    "id": "5-2",
                    "node": "{{router3_name}}",
                    "command": "show running-config | include mpls",
                    "expected_result": {
                        "op": "empty"
                    }
                }
            ]
        }
    ]
}
